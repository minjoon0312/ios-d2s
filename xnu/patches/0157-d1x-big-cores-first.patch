diff --git a/bsd/dev/d2s_cpufreq.c b/bsd/dev/d2s_cpufreq.c
index 04b45e4..8c1a578 100644
--- a/bsd/dev/d2s_cpufreq.c
+++ b/bsd/dev/d2s_cpufreq.c
@@ -822,6 +822,28 @@ d2s_cpufreq_start(void)
 		return;
 	}
 	started = true;
+	/*
+	 * 0157 (from ios-apollo 0177): tell the scheduler which CPUs are little so that
+	 * threads at priority 31+ and realtime ones (backboardd's render server, an app's
+	 * main thread) start on the fastest idle big core instead of CPU 0. d1x logical CPUs
+	 * follow the ADT order of 0140: 0-3 A55, 4-5 A75, 6-7 M4. Boot-args: sweetlittle=MASK
+	 * (default 0x0f), sweetbigfirst=0 restores XNU's own lowest-CPU-first order.
+	 */
+	{
+		extern uint64_t sweet_little_cpus;      /* osfmk/kern/sched_prim.c */
+		extern int sweet_fast_pri;
+		uint64_t little = 0x0f;
+		unsigned bigfirst = 1;
+		(void)PE_parse_boot_argn("sweetlittle", &little, sizeof(little));
+		(void)PE_parse_boot_argn("sweetbigfirst", &bigfirst, sizeof(bigfirst));
+		if (bigfirst) {
+			sweet_little_cpus = little;
+		} else {
+			sweet_little_cpus = 0;
+			sweet_fast_pri = 1000;          /* nothing counts as fast: lowest CPU first */
+		}
+		LOG("0157: little cpus %#llx, big first %u", (unsigned long long)sweet_little_cpus, bigfirst);
+	}
 	d2s_cpufreq_boot();
 	d2s_thermal_start();    /* 0147: its own thread, after every boot-time ACPM call */
 }
