-void
-d2s_cpufreq_start(void)
+/*
+ * 0147 thermal guard (d1x/d2s). Nothing cooled these SoCs under XNU: no TMU driver, and the
+ * APM's TMU plugin (acpm_tmu, ACPM channel 9) waits for Linux's exynos_acpm_tmu_set_init().
+ * Now that d2scpufreq raises the A55 to 1950 MHz and SMP adds cores, a kernel thread reads
+ * the CPU temperatures every 2 s and steps the clocks this file raised down by one ACPM level
+ * per 2 s at d2sthermal_hot or above, straight to the floor at d2sthermal_crit, and back up by
+ * one level per 2 s at d2sthermal_cool or below, never above what boot asked for. One log line
+ * every 30 s, one per change.
+ *
+ * TMU (CruelKernel cruel-HVJ5-v5.3 drivers/thermal/samsung/exynos_tmu.c, CONFIG_SOC_EXYNOS9820
+ * block and exynos98X0_tmu_initialize(), all_temp_show(); exynos9825.dts BIG/MID/LITTLE@10090000):
+ * one TMU at 0x10090000, sensor 4 LITTLE (sensors = <0x10>), 5 MID (<0x20>), 6-10 BIG (<0x7c0>);
+ * CONTROL 0x50 (bit 0 CORE_EN, bit 12 THERM_TRIP_EN), CURRENT_TEMP 0x84 + (sensor / 2) * 4,
+ * 9 bits at (sensor % 2) * 16; TRIMINFO(n) = n * 4: [8:0] temp_error1, [17:9] temp_error2,
+ * TRIMINFO(0) bit 23 two-point trimming. Celsius: one-point code - e1 + 25, two-point
+ * (code - e1) * (85 - 25) / (e2 - e1) + 25 (samsung,tmu_first/second_point_trim 0x19/0x55; e1 0
+ * -> samsung,tmu_efuse_value 0x37). Its PCLK gate: CMU_PERIS 0x10020000 +0x204c (cmucal-sfr.c).
+ * Samsung's own trips (exynos9825.dts thermal-zones): BIG/MID passive 83 C, LITTLE first
+ * cooling trip 76 C, "hot" 115 C, hardware trip samsung,tmu_default_trip_temp 0x73 = 115 C.
+ *
+ * Reading is read only, so d2sthermal defaults to 1. Clocks are only asked for when the TMU
+ * reads valid twice in a row (core enabled, every code non-zero, -20..125 C), and only for
+ * clusters this file raised at boot (d2scpufreq, d2scpufreq_mid; the M4 is not managed: its
+ * requests go through the HIU on Samsung's kernel). A read that goes bad holds the clocks.
+ *
+ * Boot-args: d2sthermal=0 off, 1 (default) read and act, 2 read and log only;
+ * d2sthermal_hot=C (85), d2sthermal_cool=C (75), d2sthermal_crit=C (95), d2sthermal_floor=KHZ
+ * (949000: the lowest level at or above it is the floor); d2sthermal_tmuon=1 (opt-in, a write):
+ * if S-Boot left CORE_EN clear, run exynos98X0_tmu_control()'s set-up without interrupts and
+ * without THERM_TRIP_EN, then set CORE_EN.
+ */
+#define TMU_PA          0x10090000UL
+#define PERIS_PA        0x10020000UL
+#define TMU_CONTROL     0x50
+#define TMU_CONTROL1    0x54
+#define TMU_AVG_CON     0x58
+#define TMU_TRIM0       0x5c
+#define TMU_COUNTER0    0x74
+#define TMU_COUNTER1    0x78
+#define TMU_TEMP(s)     (0x84u + ((s) / 2) * 4)
+#define TLOG(fmt, ...)  printf("D2S THERMAL: " fmt "\n", ##__VA_ARGS__)
+
+static uint32_t th_raised[2];           /* kHz asked for at boot: A55, A75 (0 = not managed) */
+static uint32_t th_cap[2];              /* kHz asked for now */
+static uint32_t th_mode = 1, th_hot = 85, th_cool = 75, th_crit = 95, th_floor = 949000;
+static volatile uint8_t *tmu;
+static int th_event;
+static LCK_GRP_DECLARE(d2s_acpm_grp, "d2s_acpm");
+static LCK_MTX_DECLARE(d2s_acpm_lock, &d2s_acpm_grp);   /* acpm_call() after boot */
+
+static const struct { const char *name; uint32_t sensors; } th_zone[3] = {
+	{ "LITTLE", 0x010 }, { "MID", 0x020 }, { "BIG", 0x7c0 },
+};
+
+static inline uint32_t tr(uint32_t o) { return *(volatile uint32_t *)(tmu + o); }
+static inline void tw(uint32_t o, uint32_t v) { *(volatile uint32_t *)(tmu + o) = v; __asm__ volatile ("dsb sy" ::: "memory"); }
+
+static int
+tmu_celsius(unsigned s, uint32_t code)
+{
+	uint32_t trim = tr(s * 4);
+	int e1 = (int)(trim & 0x1ff), e2 = (int)((trim >> 9) & 0x1ff);
+	if (e1 == 0) {
+		e1 = 0x37;
+	}
+	if ((tr(0) & (1u << 23)) && e2 > e1) {
+		return ((int)code - e1) * (85 - 25) / (e2 - e1) + 25;
+	}
+	return (int)code - e1 + 25;
+}
+
+/* LITTLE, MID, BIG (hottest sensor of each); false and *why if the TMU is off or a code is bad. */
+static bool
+tmu_read(int t[3], uint32_t *why)
+{
+	uint32_t ctl = tr(TMU_CONTROL);
+	if (!(ctl & 1u)) {
+		*why = ctl;
+		return false;
+	}
+	for (unsigned z = 0; z < 3; z++) {
+		int best = -1000;
+		for (unsigned s = 0; s < 16; s++) {
+			if (!(th_zone[z].sensors & (1u << s))) {
+				continue;
+			}
+			uint32_t code = (tr(TMU_TEMP(s)) >> ((s % 2) * 16)) & 0x1ff;
+			int c = tmu_celsius(s, code);
+			if (code == 0 || c < -20 || c > 125) {
+				*why = 0x80000000u | s << 16 | code;
+				return false;
+			}
+			best = c > best ? c : best;
+		}
+		t[z] = best;
+	}
+	return true;
+}
+
+/* d2sthermal_tmuon=1: exynos98X0_tmu_control(on) minus interrupts and THERM_TRIP_EN. */
+static void
+tmu_enable(void)
+{
+	uint32_t vref = (tr(0) >> 18) & 0x1f, slope = (tr(4) >> 18) & 0xf, avg = (tr(8) >> 18) & 7;
+	uint32_t bgri = (tr(12) >> 18) & 0xf, vreft = (tr(16) >> 18) & 0xf, vbei = (tr(20) >> 18) & 0xf;
+	uint32_t ctl = tr(TMU_CONTROL) & ~((0x1fu << 24) | (0xfu << 8) | (1u << 12) | 1u);
+	tw(TMU_CONTROL, ctl | vref << 24 | slope << 8);
+	tw(TMU_CONTROL1, tr(TMU_CONTROL1) & ~(1u << 10));      /* LPI_MODE off, NUM_PROBE as it is */
+	tw(TMU_AVG_CON, (tr(TMU_AVG_CON) & ~(7u | 1u << 4)) | (avg ? (avg | 1u << 4) : 0));
+	tw(TMU_COUNTER0, (tr(TMU_COUNTER0) & ~0xffffu) | 0x028a);
+	tw(TMU_COUNTER1, (tr(TMU_COUNTER1) & ~(0xffffu << 16)) | 0x028au << 16);
+	tw(TMU_TRIM0, (tr(TMU_TRIM0) & ~(0xfu << 20 | 0xfu << 12 | 0xfu << 8)) | bgri << 20 | vreft << 12 | vbei << 8);
+	tw(TMU_CONTROL, tr(TMU_CONTROL) | 1u);
+}
+
+/* The enabled levels of a domain at or below its DT max (fvmap, else the DT table), no log. */
+static unsigned
+dom_levels(const struct dom *d, uint32_t *out, unsigned max)
+{
+	unsigned n = 0;
+	if (fvmap_off) {
+		uint32_t h = fvmap_off + FVH_BYTES * d->id, lv = sram[h + FVH_NUM_LV];
+		uint32_t o_rv = sram[h + FVH_O_RATEVOLT] | (uint32_t)sram[h + FVH_O_RATEVOLT + 1] << 8;
+		for (uint32_t i = 0; i < lv && i < 32 && n < max && fvmap_off + o_rv + 8 * i + 8 <= SRAM_SIZE; i++) {
+			uint32_t rate = sr(fvmap_off + o_rv + 8 * i), volt = sr(fvmap_off + o_rv + 8 * i + 4);
+			if (volt && rate && rate <= d->dt_max) {
+				out[n++] = rate;
+			}
+		}
+		return n;
+	}
+	for (unsigned i = 0; i < d->nlevels && n < max; i++) {
+		out[n++] = d->levels[i];
+	}
+	return n;
+}
+
+/* dir < 0: the next level below khz; dir > 0: the next above; dir 0: the lowest. In [lo, hi]. */
+static uint32_t
+th_level(const struct dom *d, uint32_t khz, int dir, uint32_t lo, uint32_t hi)
+{
+	uint32_t lv[32], best = 0;
+	unsigned n = dom_levels(d, lv, 32);
+	for (unsigned i = 0; i < n; i++) {
+		uint32_t r = lv[i];
+		if (r < lo || r > hi) {
+			continue;
+		}
+		if (dir < 0 ? (r < khz && r > best) : ((dir > 0 ? r > khz : true) && (best == 0 || r < best))) {
+			best = r;
+		}
+	}
+	return best;
+}
+
+static void
+th_thread(void *arg, wait_result_t wr)
+{
+	int t[3] = { 0, 0, 0 };
+	unsigned tick, good = 0, bad = 0, downs = 0, ups = 0, fails = 0;
+	uint32_t why = 0;
+	(void)arg;
+	(void)wr;
+	for (tick = 0;; tick++) {
+		int s[3];
+		bool ok = tmu_read(s, &why);
+		if (ok) {
+			t[0] = s[0];
+			t[1] = s[1];
+			t[2] = s[2];
+			bad = 0;
+		} else if (bad++ % 15 == 0) {
+			TLOG("TMU read not valid (%#x): clocks held", why);
+		}
+		/* the hottest CPU zone steers both clusters (heat spreads over the die) */
+		int hot = t[0] > t[1] ? t[0] : t[1];
+		hot = t[2] > hot ? t[2] : hot;
+		good = ok ? good + 1 : 0;
+		for (unsigned d = 0; ok && good >= 2 && th_mode == 1 && d < 2; d++) {
+			uint32_t want = 0;
+			if (th_raised[d] == 0) {
+				continue;
+			}
+			if (hot >= (int)th_crit) {
+				want = th_level(&doms[d], 0, 0, th_floor, th_raised[d]);
+			} else if (hot >= (int)th_hot) {
+				want = th_level(&doms[d], th_cap[d], -1, th_floor, th_raised[d]);
+			} else if (hot <= (int)th_cool) {
+				want = th_level(&doms[d], th_cap[d], 1, th_floor, th_raised[d]);
+			}
+			if (want == 0 || want == th_cap[d] || (hot > (int)th_cool && want > th_cap[d])) {
+				continue;
+			}
+			uint32_t cmd[4] = { doms[d].id, want, FREQ_REQ, 0 };
+			lck_mtx_lock(&d2s_acpm_lock);
+			int e = acpm_call(cmd);
+			lck_mtx_unlock(&d2s_acpm_lock);
+			if (e == 0) {
+				TLOG("%d C: %s %u -> %u kHz", hot, doms[d].name, th_cap[d], want);
+				if (want < th_cap[d]) {
+					downs++;
+				} else {
+					ups++;
+				}
+				th_cap[d] = want;
+			} else if (fails++ < 8) {
+				TLOG("%d C: %s -> %u kHz: ACPM error %d, held at %u kHz", hot, doms[d].name, want, e, th_cap[d]);
+			}
+		}
+		if (tick % 15 == 0) {
+			TLOG("LITTLE %d C, MID %d C, BIG %d C%s; A55 %u kHz (max %u), A75 %u kHz (max %u); %u down, %u up",
+			    t[0], t[1], t[2], ok ? "" : " (last valid)", th_cap[0], th_raised[0], th_cap[1], th_raised[1],
+			    downs, ups);
+		}
+		uint64_t deadline;
+		clock_interval_to_deadline(2000, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&th_event, THREAD_UNINT, deadline);
+		(void)thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+static void
+d2s_thermal_start(void)
+{
+	volatile uint8_t *peris;
+	uint32_t gate, on = 0, why = 0;
+	int t[3] = { 0, 0, 0 };
+	thread_t th;
+
+	PE_parse_boot_argn("d2sthermal", &th_mode, sizeof(th_mode));
+	if (th_mode == 0) {
+		TLOG("off (d2sthermal=0)");
+		return;
+	}
+	PE_parse_boot_argn("d2sthermal_hot", &th_hot, sizeof(th_hot));
+	PE_parse_boot_argn("d2sthermal_cool", &th_cool, sizeof(th_cool));
+	PE_parse_boot_argn("d2sthermal_crit", &th_crit, sizeof(th_crit));
+	PE_parse_boot_argn("d2sthermal_floor", &th_floor, sizeof(th_floor));
+	PE_parse_boot_argn("d2sthermal_tmuon", &on, sizeof(on));
+	if (th_cool >= th_hot || th_hot > th_crit || th_crit > 110 || th_hot < 50) {
+		TLOG("thresholds cool %u hot %u crit %u out of order: 75/85/95 used", th_cool, th_hot, th_crit);
+		th_cool = 75;
+		th_hot = 85;
+		th_crit = 95;
+	}
+	peris = (volatile uint8_t *)ml_io_map(PERIS_PA, 0x4000);
+	tmu = (volatile uint8_t *)ml_io_map(TMU_PA, 0x1000);
+	if (!peris || !tmu) {
+		TLOG("map failed");
+		return;
+	}
+	gate = *(volatile uint32_t *)(peris + 0x204c);
+	if ((gate & (1u << 20)) && !(gate & (1u << 21))) {
+		TLOG("TMU_TOP PCLK gated off (%#x): TMU not read", gate);
+		return;
+	}
+	if (!(tr(TMU_CONTROL) & 1u) && on) {
+		TLOG("CONTROL %#x: TMU core off, enabling it (d2sthermal_tmuon=1)", tr(TMU_CONTROL));
+		tmu_enable();
+		delay(10000);
+	}
+	for (unsigned d = 0; d < 2; d++) {
+		th_cap[d] = th_raised[d];
+	}
+	bool ok = tmu_read(t, &why);
+	TLOG("mode %u, cool %u hot %u crit %u C, floor %u kHz; TMU gate %#x CONTROL %#x (core %u trip %u) TRIMINFO0 %#x "
+	    "(%s-point); %s: LITTLE %d MID %d BIG %d C; managing A55 %s, A75 %s", th_mode, th_cool, th_hot, th_crit,
+	    th_floor, gate, tr(TMU_CONTROL), tr(TMU_CONTROL) & 1u, (tr(TMU_CONTROL) >> 12) & 1u, tr(0),
+	    (tr(0) & (1u << 23)) ? "two" : "one", ok ? "valid" : "not valid", t[0], t[1], t[2],
+	    th_raised[0] ? "yes" : "no", th_raised[1] ? "yes" : "no");
+	if (kernel_thread_start(th_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	} else {
+		TLOG("thread start failed");
+	}
+}
+
+static void
+d2s_cpufreq_boot(void)
 {
 	static bool done;
 	uint32_t want[3] = { 0, 0, 0 }, cmu_all = 0, off = 0;
@@ -520,6 +804,9 @@ d2s_cpufreq_start(void)
 		uint32_t cmd[4] = { doms[d].id, rate, FREQ_REQ, 0 };
 		int e = acpm_call(cmd);
 		LOG("%s -> %u kHz: %d (reply %#x %#x %#x %#x)", doms[d].name, rate, e, cmd[0], cmd[1], cmd[2], cmd[3]);
+		if (e == 0 && d < 2) {
+			th_raised[d] = rate;    /* 0147: the thermal guard's ceiling for this cluster */
+		}
 		delay(10000);
 		log_cmu(&doms[d], "after");
 		LOG("ACPM get after: %s %u kHz", doms[d].name, get_rate(doms[d].id));
@@ -527,6 +814,18 @@ d2s_cpufreq_start(void)
 	measure_mhz("now");
 }
 
+void
+d2s_cpufreq_start(void)
+{
+	static bool started;
+	if (started) {
+		return;
+	}
+	started = true;
+	d2s_cpufreq_boot();
+	d2s_thermal_start();    /* 0147: its own thread, after every boot-time ACPM call */
+}
+
 #else
 void
 d2s_cpufreq_start(void)
