+/*
+ * 0147 d2sfb_hzprobe (default 1, 0 off): the panel's real update rate, logged once about 5 s
+ * after AppleCLCD starts, from a thread of its own. READ ONLY: no DECON or CMU register is
+ * written (the frame-done pending bit is not counted: that needs a write-1-to-clear).
+ *
+ * Why: the Galaxy S7 port (wardevsa/ios-a5xelte, branch herolte) found its panel at 20 Hz
+ * because the display clock was left on the 26 MHz oscillator. Here the S6E3FA7 runs in
+ * command mode: every TE starts a DECON fetch and DSI transfer of the whole frame, so a slow
+ * DPU clock shows as a long busy time per frame and fewer frames than TEs.
+ *
+ * Over 1 s (CruelKernel cruel-HVJ5-v5.3 dpu20/cal_9820/regs-decon.h):
+ *   GLOBAL_CONTROL 0x000 bit 5 IDLE_STATUS sampled every ~100 us (IODelay is a timer sleep on
+ *     this port, see 0141 above): each busy -> idle edge is a frame done, the busy stretch is
+ *     the fetch + transfer time (about 12.8 ms at 60 Hz). A DECON busy nearly all the time
+ *     with short idle gaps can be undercounted: the busy share is printed too;
+ *   FRAME_COUNT 0x2a0 and HW_TE_CNT 0x078 (HW_TRIG_CNT_A [15:0], _B [31:16]): read before and
+ *     after, printed as they are (Samsung's driver never reads them; meaning unverified);
+ *   HW_SW_TRIG_CONTROL 0x070: HW_TRIG_EN bit 0, MASK_DECON bit 4, HW_TRIG_SKIP [23:16] (a
+ *     TE skip count divides the rate).
+ * The DPU clock (cal-if/exynos9820 cmucal-sfr.c, cmucal-node.c): CMU_DPU 0x19000000
+ *   PLL_CON0_MUX_CLKCMU_DPU_BUS_USER +0x100 bit 4 (0 = OSCCLK_DPU 26 MHz, the S7 case;
+ *   1 = CLKCMU_DPU_BUS of CMU_TOP), DIV_CLK_DPU_BUSP +0x1800; CMU_TOP 0x1a240000:
+ *   CLKCMU_DPU_BUS +0x1000 bit 0 (0 DIV_CLKCMU_DPU, 1 DIV_CLKCMU_DPU_BUS), MUX_CLKCMU_DPU_BUS
+ *   +0x1040 [1:0] (PLL_SHARED3, PLL_SHARED4, PLL_SHARED1/3, PLL_SHARED2/2), DIV_CLKCMU_DPU_BUS
+ *   +0x18c4 [3:0], gate +0x2054; MUX_CLKCMU_DPU +0x103c bit 0 (PLL_SHARED0/3, /4),
+ *   DIV_CLKCMU_DPU +0x18c0 [2:0], gate +0x2050; PLL_SHARED0..4 CON0 +0x160 + 0x20 n (ENABLE
+ *   31, M [25:16], P [13:8], S [2:0], 26 MHz in). The DPU MHz assumes the nominal /3 and /2
+ *   and MUX_PLL_SHAREDn on the PLLs: an estimate, printed with the raw registers.
+ */
+#define DECON_RUN_STATUS                (1u << 4)       /* regs-decon.h:100 */
+#define DECON_OPERATION_MODE_CMD        (1u << 8)       /* :97 */
+#define DECON_HW_TE_CNT                 0x078           /* :170 */
+#define DECON_FRAME_COUNT               0x2a0           /* :374 */
+#define D2S_CMU_DPU_PHYS                0x19000000      /* cmucal-sfr.c SFR_BLOCK(CMU_DPU) */
+#define D2S_CMU_TOP_PHYS                0x1a240000      /* SFR_BLOCK(CMU_CMU) */
+
+static uint32_t
+d2s_pll_mhz(uint32_t con0)
+{
+	uint32_t m = (con0 >> 16) & 0x3ff, p = (con0 >> 8) & 0x3f, s = con0 & 7;
+	if (!(con0 & (1u << 31))) {
+		return 26;
+	}
+	return p ? (uint32_t)(26ULL * m / ((uint64_t)p << s)) : 0;
+}
+
+static uint32_t
+d2s_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static void
+d2s_hzprobe(void *, wait_result_t)
+{
+	vm_offset_t decon = ml_io_map(D2S_DECON_PHYS, 0x1000);
+	vm_offset_t dpu = ml_io_map(D2S_CMU_DPU_PHYS, 0x2000);
+	vm_offset_t top = ml_io_map(D2S_CMU_TOP_PHYS, 0x3000);
+	uint64_t t0, now, prev, win, busyStart = 0, busySum = 0, busyMax = 0, busyAll = 0, ns = 0, avgNs = 0, maxNs = 0, allNs = 0;
+	uint32_t edges = 0, busyN = 0, samples = 0, fc0, fc1, te0, te1, gc, trig, sh[5], mhz, src;
+	bool idle;
+
+	IOSleep(5000);
+	if (decon == 0 || dpu == 0 || top == 0) {
+		IOLog("SWEET FB: hz probe: map failed\n");
+		return;
+	}
+	gc = d2s_rd(decon, DECON_GLOBAL_CONTROL);
+	trig = d2s_rd(decon, DECON_HW_SW_TRIG_CONTROL);
+	nanoseconds_to_absolutetime(1000000000ULL, &win);
+	fc0 = d2s_rd(decon, DECON_FRAME_COUNT);
+	te0 = d2s_rd(decon, DECON_HW_TE_CNT);
+	idle = (d2s_rd(decon, DECON_GLOBAL_CONTROL) & DECON_IDLE_STATUS) != 0;
+	t0 = prev = now = mach_absolute_time();
+	while (now - t0 < win) {
+		IODelay(100);
+		now = mach_absolute_time();
+		bool i = (d2s_rd(decon, DECON_GLOBAL_CONTROL) & DECON_IDLE_STATUS) != 0;
+		samples++;
+		if (!i) {
+			busyAll += now - prev;
+		}
+		if (idle && !i) {
+			busyStart = now;
+		} else if (!idle && i) {
+			edges++;
+			if (busyStart != 0) {
+				busySum += now - busyStart;
+				busyMax = now - busyStart > busyMax ? now - busyStart : busyMax;
+				busyN++;
+			}
+		}
+		idle = i;
+		prev = now;
+	}
+	fc1 = d2s_rd(decon, DECON_FRAME_COUNT);
+	te1 = d2s_rd(decon, DECON_HW_TE_CNT);
+	absolutetime_to_nanoseconds(now - t0, &ns);
+	absolutetime_to_nanoseconds(busyN ? busySum / busyN : 0, &avgNs);
+	absolutetime_to_nanoseconds(busyMax, &maxNs);
+	absolutetime_to_nanoseconds(busyAll, &allNs);
+	IOLog("SWEET FB: hz probe: %u frame-done edges in %llu ms = %llu.%llu Hz (%u samples; busy avg %llu us, max %llu us, "
+	    "busy %llu%% of the time); FRAME_COUNT %#x -> %#x, HW_TE_CNT %#x -> %#x; control %#x (run %u, command mode %u), "
+	    "trigger %#x (hw %u, masked %u, TE skip %u)\n", edges, ns / 1000000,
+	    ns ? (uint64_t)edges * 1000000000ULL / ns : 0, ns ? ((uint64_t)edges * 10000000000ULL / ns) % 10 : 0, samples,
+	    avgNs / 1000, maxNs / 1000, ns ? allNs * 100 / ns : 0, fc0, fc1, te0, te1, gc, (gc & DECON_RUN_STATUS) != 0,
+	    (gc & DECON_OPERATION_MODE_CMD) != 0, trig, trig & DECON_HW_TRIG_EN, (trig & DECON_HW_TRIG_MASK_DECON) != 0,
+	    (trig >> 16) & 0xff);
+
+	uint32_t user = d2s_rd(dpu, 0x100), busp = d2s_rd(dpu, 0x1800);
+	uint32_t sel = d2s_rd(top, 0x1000), mbus = d2s_rd(top, 0x1040), dbus = d2s_rd(top, 0x18c4);
+	uint32_t mdpu = d2s_rd(top, 0x103c), ddpu = d2s_rd(top, 0x18c0);
+	for (unsigned n = 0; n < 5; n++) {
+		sh[n] = d2s_pll_mhz(d2s_rd(top, 0x160 + 0x20 * n));
+	}
+	if (!(user & (1u << 4))) {
+		mhz = 26;
+	} else if (sel & 1u) {
+		const uint32_t from[4] = { sh[3], sh[4], sh[1] / 3, sh[2] / 2 };
+		src = from[mbus & 3u];
+		mhz = src / ((dbus & 0xfu) + 1);
+	} else {
+		src = (mdpu & 1u) ? sh[0] / 4 : sh[0] / 3;
+		mhz = src / ((ddpu & 7u) + 1);
+	}
+	IOLog("SWEET FB: DPU clock: BUS_USER %#x (%s), BUSP div %#x; CMU_TOP CLKCMU_DPU_BUS %#x mux %#x div %#x gate %#x, "
+	    "CLKCMU_DPU mux %#x div %#x gate %#x; PLL_SHARED0-4 %u %u %u %u %u MHz; DPU bus ~%u MHz (estimate)%s\n",
+	    user, (user & (1u << 4)) ? "CMU_TOP" : "OSCCLK 26 MHz", busp, sel, mbus, dbus, d2s_rd(top, 0x2054), mdpu, ddpu,
+	    d2s_rd(top, 0x2050), sh[0], sh[1], sh[2], sh[3], sh[4], mhz,
+	    mhz < 100 ? ": slow DPU clock, as the S7's 20 Hz panel" : "");
+}
 #endif /* D2S */
 #endif /* DREAMLTE */
 
