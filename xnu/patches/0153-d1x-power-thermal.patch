+#if defined(D2S)
+/*
+ * 0147: battery of the Note 10 5G (d1x) and Note 10+ (d2s): Maxim MAX77705 (charger, fuel
+ * gauge and USB-C controller in one) on hsi2c_45, 0x15D60000. That HSI2C is USI_CMGP03 of the
+ * CMGP block (exynos9825.dts: aliases hsi2c45 = "/hsi2c@15D60000", usi_03_cmgp =
+ * "/usi@15C22030"; hsi2c@15D60000 default-clk 200 MHz, samsung,usi-i2c-v2,
+ * samsung,scl-clk-stretching and no samsung,stop-after-trans; d1x DTS: max77705@66 and
+ * pca9468@57 on it, d1x_common.dtsi &usi_03_cmgp usi_v2_mode = "i2c"). ios-d2s commit 4675149
+ * named the bus hsi2c_12; it is hsi2c_45.
+ *
+ * Registers (Samsung drivers/battery_v2/max77705_fuelgauge.c, _charger.c and
+ * include/linux/mfd/max77705-private.h, CruelKernel cruel-HVJ5-v5.3; the same list as
+ * Scion-Project/scion-kernel drivers/power/max77705/hakios.max77705.c, APSL-2.0, which was read
+ * for it, nothing copied):
+ *   PMIC 0x66: 0x00 PMICID1 (0x05 or 0x15, mfd/max77705.c max77705_revision[]), 0x01 PMICREV
+ *   gauge 0x36, 16 bit LE: 0x00 STATUS (bit 3 no battery), 0x06 RepSOC (1/256 %), 0x09 VCELL
+ *     (78.125 uV), 0x0A Current (signed; fuelgauge,fg_resistor = 2 in the d1x DTS: 5 mOhm,
+ *     312.5 uA, positive while charging), 0x05 RepCap and 0x35 FullCapRep (1 mAh at 5 mOhm)
+ *   charger 0x69: 0xB2 CHG_INT_OK (bit 6 CHGIN_OK, bit 5 WCIN_OK), 0xB4 DETAILS_01 [3:0]
+ *     (0-2 charging, 3-4 full, 5-7 not charging, 8 off), 0xB7 CNFG_00 (bit 4 WDTEN),
+ *     0xBD CNFG_06 ([1:0] WDTCLR)
+ * Nothing on the chip is written except, opt-in, the charger watchdog kick below. Interrupt
+ * registers (0xB0 and the like) are not read: reading clears them.
+ *
+ * The bus is checked before any HSI2C register is touched, read only: CMU_CMGP 0x15C00000
+ * (cmucal-sfr.c exynos9820: PLL_CON0_MUX_CLKCMU_CMGP_BUS_USER +0x100 bit 4, MUX_CLK_USI_CMGP3
+ * +0x1020 bit 0, DIV_CLK_USI_CMGP3 +0x1824 [3:0], gates USI_CMGP3 IPCLK +0x2088, PCLK +0x208c,
+ * RSTNSYNC_CLK_CMGP_USI3 +0x205c with MANUAL bit 20 / CG_VAL bit 21, QCH +0x304c) and the USI
+ * mode word (usi_v2.c: I2C_SW_CONF = 1 << 2). A gate forced off or a USI not in I2C mode: the
+ * bus is never touched (S-Boot talks to this chip, so both should be set up). The input clock:
+ * OSCCLK_RCO_CMGP 49.152 MHz (cmucal-node.c FIXEDRATE) when a mux picks it, else at most the
+ * 400 MHz of CLKCMU_CMGP_BUS (cmucal-vclk.c) over the divider; timing for that upper bound
+ * keeps SCL at or below 400 kHz whatever the real rate (a slower clock only slows SCL).
+ * Boot-arg d1xbat_clk=HZ overrides it. As on the touch bus (patch 0130 comment), Samsung's
+ * timing fields are the 9820 masks, worked out by s8i2c_reset().
+ *
+ * Boot-args: sweetbattery (SweetBattery.cpp: 1 reads, 0 static fallback; the d1x boot image
+ * of tools/d2s_make_boot.py passes 0 today), d1xbat_clk=HZ, d1xbat_rs=0 (STOP between the
+ * register write and the read instead of a repeated START; also tried by itself if the
+ * repeated START fails), d1xbat_wdt=1 (opt-in, the one write to the charger: Samsung's
+ * max77705_chg_set_wdtmr_kick(), CNFG_06 WDTCLR = 01, the rest of CNFG_06 as read, and only
+ * while CNFG_00 reads WDTEN set; Scion's S9 notes say S-Boot leaves the watchdog on and the
+ * charger stops within minutes without the kick. Not verified on the d1x).
+ */
+#define D1XBAT_CMU_CMGP_PA      0x15c00000u
+#define D1XBAT_USI_MODE_PA      0x15c22030u
+#define D1XBAT_PMIC             0x66u
+#define D1XBAT_RCO_HZ           49152000u
+#define D1XBAT_BUS_MAX_HZ       400000000u
+static int s8bat_state;         /* 0 not tried, 1 ready, -1 refused: the bus is not touched again */
+static uint32_t s8bat_wdt;
+static unsigned s8bat_polls, s8bat_misses, s8bat_kicks;
+static int s8bat_last_ext = -1, s8bat_last_dtls = -1;
+
+static bool
+s8bat_read8(unsigned addr, uint8_t reg, uint8_t *value)
+{
+	return s8i2c_xfer(s8bat_i2c, addr, &reg, 1, value, 1);
+}
+
+static bool
+s8bat_gate_off(uint32_t v)
+{
+	return (v & (1u << 20)) && !(v & (1u << 21));  /* MANUAL set, CG_VAL clear */
+}
+
+static bool
+s8bat_setup(void)
+{
+	vm_offset_t cmu = ml_io_map(D1XBAT_CMU_CMGP_PA, 0x4000);
+	vm_offset_t usi = ml_io_map(D1XBAT_USI_MODE_PA & ~0xfffu, 0x1000);
+	uint32_t user, mux, div, ip, pclk, rst, qch, mode, clk = 0, ovr = 0, rs = 1;
+	uint8_t id = 0, rev = 0;
+	uint16_t st = 0;
+	int pass;
+
+	(void)PE_parse_boot_argn("d1xbat_clk", &ovr, sizeof(ovr));
+	(void)PE_parse_boot_argn("d1xbat_rs", &rs, sizeof(rs));
+	(void)PE_parse_boot_argn("d1xbat_wdt", &s8bat_wdt, sizeof(s8bat_wdt));
+	if (!cmu || !usi) {
+		printf("S8 BATTERY: CMU_CMGP / SYSREG_CMGP map failed\n");
+		return false;
+	}
+	user = a5touch_read(cmu, 0x100);
+	mux = a5touch_read(cmu, 0x1020);
+	div = a5touch_read(cmu, 0x1824);
+	ip = a5touch_read(cmu, 0x2088);
+	pclk = a5touch_read(cmu, 0x208c);
+	rst = a5touch_read(cmu, 0x205c);
+	qch = a5touch_read(cmu, 0x304c);
+	mode = a5touch_read(usi, D1XBAT_USI_MODE_PA & 0xfffu);
+	if (!(mux & 1u) || !(user & (1u << 4))) {
+		clk = D1XBAT_RCO_HZ / ((div & 0xfu) + 1);      /* exact */
+	} else {
+		clk = D1XBAT_BUS_MAX_HZ / ((div & 0xfu) + 1);  /* upper bound */
+	}
+	if (ovr >= 1000000u && ovr <= D1XBAT_BUS_MAX_HZ) {
+		clk = ovr;
+	}
+	printf("S8 BATTERY: hsi2c_45 CMU_CMGP bus_user %#x usi3 mux %#x div %#x gates ip %#x pclk %#x rst %#x "
+	    "qch %#x, USI mode %#x -> input %u Hz%s\n", user, mux, div, ip, pclk, rst, qch, mode, clk,
+	    ovr ? " (d1xbat_clk)" : ((mux & 1u) && (user & (1u << 4)) ? " (upper bound)" : ""));
+	if (s8bat_gate_off(ip) || s8bat_gate_off(pclk) || s8bat_gate_off(rst) || (mode & 7u) != 4u) {
+		printf("S8 BATTERY: hsi2c_45 clock gated off or USI not in I2C mode: not touched\n");
+		return false;
+	}
+	s8bat_clkin = clk;
+	s8bat_i2c = ml_io_map(S8BAT_HSI2C_PA, 0x1000);
+	if (!s8bat_i2c) {
+		return false;
+	}
+	if (a5touch_read(s8bat_i2c, 0xc4) & 1u) {       /* USI_CON: USI_RESET, i2c-exynos5.c exynos_usi_init() */
+		printf("S8 BATTERY: USI_CON %#x: USI reset held, released\n", a5touch_read(s8bat_i2c, 0xc4));
+		a5touch_write(s8bat_i2c, 0xc4, 0);
+	}
+	s8i2c_reset(s8bat_i2c);
+	for (pass = 0; pass < 2; pass++) {
+		s8bat_rs = rs != 0 && pass == 0;
+		if (s8bat_read8(D1XBAT_PMIC, 0x00, &id) && s8bat_read8(D1XBAT_PMIC, 0x01, &rev) &&
+		    s8bat_read16(S8BAT_FG, 0x00, &st)) {
+			printf("S8 BATTERY: MAX77705 PMICID1 %#x%s PMICREV %#x, gauge STATUS %#x (%s)\n", id,
+			    (id == 0x05 || id == 0x15) ? "" : " (not 0x05/0x15: unknown revision)", rev, st,
+			    s8bat_rs ? "repeated START" : "STOP between write and read");
+			return true;
+		}
+		printf("S8 BATTERY: no MAX77705 with %s (PMICID1 %#x)\n",
+		    s8bat_rs ? "repeated START" : "STOP", id);
+		if (rs == 0) {
+			break;
+		}
+	}
+	return false;
+}
+
+/* d1xbat_wdt=1: Samsung's watchdog kick, only while WDTEN is set (see above). */
+static void
+s8bat_kick(void)
+{
+	uint8_t c0 = 0, c6 = 0, w[2];
+	bool ok;
+	if (!s8bat_read8(S8BAT_CHG, 0xb7, &c0) || !s8bat_read8(S8BAT_CHG, 0xbd, &c6) || !(c0 & 0x10u)) {
+		return;
+	}
+	w[0] = 0xbd;
+	w[1] = (uint8_t)((c6 & ~0x03u) | 0x01u);
+	ok = s8i2c_xfer(s8bat_i2c, S8BAT_CHG, w, 2, NULL, 0);
+	if (s8bat_kicks++ == 0) {
+		printf("S8 BATTERY: charger watchdog: CNFG_00 %#x, CNFG_06 %#x written %#x: %s\n", c0, c6, w[1],
+		    ok ? "kicked" : "FAILED");
+	}
+}
+
+static int
+d1xbat_read(unsigned *percent, unsigned *mv, int *ma, int *external, int *charging, int *full)
+{
+	uint16_t status, soc, vcell, cur;
+	uint8_t ok = 0, dtls = 0;
+	unsigned pct, d;
+	if (s8bat_state == 0) {
+		s8bat_state = s8bat_setup() ? 1 : -1;
+	}
+	if (s8bat_state < 0) {
+		return -1;
+	}
+	if (!s8bat_read16(S8BAT_FG, 0x00, &status) || !s8bat_read16(S8BAT_FG, 0x06, &soc) ||
+	    !s8bat_read16(S8BAT_FG, 0x09, &vcell) || !s8bat_read16(S8BAT_FG, 0x0a, &cur) ||
+	    !s8bat_read8(S8BAT_CHG, 0xb2, &ok) || !s8bat_read8(S8BAT_CHG, 0xb4, &dtls)) {
+		if (++s8bat_misses <= 4 || !(s8bat_misses & 63)) {
+			printf("S8 BATTERY: MAX77705 read failed (%u)\n", s8bat_misses);
+		}
+		return -1;
+	}
+	pct = (unsigned)(soc >> 8) + ((soc & 0xffu) >= 128 ? 1 : 0);
+	d = dtls & 0x0fu;
+	*percent = pct > 100 ? 100 : pct;
+	*mv = (unsigned)((uint32_t)vcell * 78125u / 1000000u);
+	*ma = (int)((int16_t)cur) * 3125 / 10000;
+	*external = (ok & 0x60u) != 0;
+	*charging = *external && d <= 2;
+	*full = *external && (d == 3 || d == 4);
+	if (s8bat_wdt) {
+		s8bat_kick();
+	}
+	/* the first sample, every charger change, and every 10 min (SweetBattery polls every 30 s) */
+	if (s8bat_polls++ % 20 == 0 || *external != s8bat_last_ext || (int)d != s8bat_last_dtls) {
+		printf("S8 BATTERY: %u%% (RepSOC %#x) %u mV %d mA, CHG_INT_OK %#x DETAILS_01 %#x STATUS %#x%s\n",
+		    *percent, soc, *mv, *ma, ok, dtls, status, (status & 0x8u) ? " (no battery)" : "");
+		s8bat_last_ext = *external;
+		s8bat_last_dtls = (int)d;
+	}
+	return (!(status & 0x8u) && *mv >= 2800 && *mv <= 4600) ? 0 : -1;
+}
+#endif /* D2S */
+
 /*
  * SweetBattery (patch 0124) calls this every 30 s. 0 = valid sample.
  * MAX77865 fuel gauge: SOCREP 0x06 in 1/256 %, VCELL 0x09 in 78.125 uV,
@@ -1100,6 +1323,9 @@ int
 dreamlte_battery_read(unsigned *percent, unsigned *mv, int *ma,
     int *external, int *charging, int *full)
 {
+#if defined(D2S)
+	return d1xbat_read(percent, mv, ma, external, charging, full);  /* MAX77705, 0147 */
+#else
 	uint16_t soc, vcell, cur;
 	uint8_t reg, ok = 0, dtls = 0;
 	if (!s8bat_i2c) {
@@ -1126,6 +1352,7 @@ dreamlte_battery_read(unsigned *percent, unsigned *mv, int *ma,
 	*charging = *external && dtls <= 2;
 	*full = *external && (dtls == 3 || dtls == 4);
 	return (*mv >= 2800 && *mv <= 4600) ? 0 : -1;
+#endif
 }
 
