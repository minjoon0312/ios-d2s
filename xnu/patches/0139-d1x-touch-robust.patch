+#if defined(D2S)
+/*
+ * d1x touch robustness (research/RESPONSIVE_9825.md 1.2, after Samsung sec_ts.c and the
+ * S8's enable retry): clear the event stack, retry the enable, recover from IC resets,
+ * never leave a finger down in iOS, back off a failing bus.
+ */
+static void
+s8ts_release_all(void)
+{
+	for (unsigned i = 0; i < S8TS_FINGERS; i++) {
+		if (s8ts_down[i]) {
+			s8ts_down[i] = false;
+			if (i < 5) {
+				sweet_hid_touch((int)i, 0, s8ts_x[i], s8ts_y[i]);
+			}
+		}
+	}
+}
+
+static void
+s8ts_clear_stack(void)
+{
+	uint8_t clr = 0x62;                                     /* CLEAR_EVENT_STACK */
+	(void)s8i2c_xfer(s8ts_i2c, S8TS_ADDR, &clr, 1, NULL, 0);
+}
+
+static bool
+s8ts_enable(void)
+{
+	uint8_t func[3] = {0x30, 0x01, 0x00};                  /* TOUCH_FUNCTION = touch */
+	uint8_t sense = 0x10;                                   /* SENSE_ON */
+	for (int i = 0; i < 20; i++) {
+		if (i) {
+			s8i2c_reset(s8ts_i2c);
+			delay(50000);
+		}
+		s8ts_clear_stack();
+		bool f = s8i2c_xfer(s8ts_i2c, S8TS_ADDR, func, 3, NULL, 0);
+		bool on = f && s8i2c_xfer(s8ts_i2c, S8TS_ADDR, &sense, 1, NULL, 0);
+		if (on) {
+			if (i) {
+				printf("S8 TOUCH: enabled after %d retries\n", i);
+			}
+			return true;
+		}
+		printf("S8 TOUCH: enable try %d: %s failed\n", i, f ? "SENSE_ON" : "TOUCH_FUNCTION");
+	}
+	return false;
+}
+
+/* Status events (eid 1). Returns true if the IC must be enabled again. */
+static bool
+s8ts_status(const uint8_t *ev)
+{
+	unsigned stype = (ev[0] >> 2) & 0xfu;
+	if (stype == 2 && ev[1] == 0x00 && ev[2] == 0x20) {    /* INFO BOOT_COMPLETE: IC reset */
+		printf("S8 TOUCH: IC reset (boot complete), enabling again\n");
+		s8ts_release_all();
+		return true;
+	}
+	if (stype == 1 && ev[1] == 0x01) {                      /* ERR QUEUE_FULL */
+		printf("S8 TOUCH: event queue full\n");
+		s8ts_clear_stack();
+		s8ts_release_all();
+	}
+	return false;
+}
+#endif /* D2S */
