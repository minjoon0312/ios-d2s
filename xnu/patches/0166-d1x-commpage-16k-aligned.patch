diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -10903,6 +10903,16 @@
 
 	do {
 		int text_leaf_index = random() % num_ptes;
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+		/*
+		 * d1x: 16 KiB VM pages over a 4 KiB hardware granule. The random slot is
+		 * in hardware pages, but the commpage text must start on a VM page, or
+		 * write_pte_fast() panics ("PTE write is unaligned"). The slot is only
+		 * randomized above 1 GiB of RAM, which is why 512 MiB always booted and
+		 * 2 GiB panicked (fact from the Galaxy S7 port, herolte xnu 0257).
+		 */
+		text_leaf_index &= ~(PAGE_RATIO - 1);
+#endif
 
 		// Generate a VA for the commpage text with the same root and twig index as data
 		// comm page, but with new leaf index we've just generated.
