 #if defined(D2S)
 static uint32_t d2s_fb_scale = 1;       /* boot-arg d2sfb_scale, see d2s_present_scaled */
 static bool d2s_fb_cleared;
+static void d2s_panel_written(void);    /* 0156: a write outside the presents (defined with the row sums) */
 /* 0141 boot-args (cheaper presents on d1x); d2sfb_vsync_hz is read in AppleCLCD::start() */
 static uint32_t d2s_fb_mask;            /* d2sfb_mask: 0 frame-done wait, 1 TE trigger mask */
