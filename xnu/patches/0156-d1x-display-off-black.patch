@@ -317,7 +318,15 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		/* Fade out: halve every channel each vsync, then black, then idle. */
 		uint32_t step = fb->fFadeStep;
 #if defined(D2S)
-		step = 7;       /* d2s: no CPU fade while the panel is off */
+		/*
+		 * 0156: d2s skipped the fade entirely, so "display off" (power button, auto-lock) left
