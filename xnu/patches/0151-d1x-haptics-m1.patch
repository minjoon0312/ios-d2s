+
+static void
+hap_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t revid = 0, v = 0;
+	bool ok = false;
+
+	LOG("level %u (%s), bus: GPIO bit-bang gpm10-0/gpm11-0 at %u us per half clock", hap_level,
+	    hap_level == 1 ? "look, no drive" : hap_level == 2 ? "ROM buzz" : "firmware click and buzz",
+	    hap_half_us);
+	if (!take_pins()) {
+		goto out;
+	}
+	/* The chip as S-Boot left it: its reset high and the ROM loaded with
+	 * S-Boot's buzz (158 / 130 / 25) if it buzzed at power-on. One try only. */
+	if (rd32n(R_DEVID, &v, 1)) {
+		LOG("before our reset the chip answers: DEVID %#x", v);
+		show_rom("as found");
+	} else {
+		LOG("before our reset the chip does not answer (held in reset or not yet up)");
+	}
+	if (!reset_and_identify(&revid)) {
+		goto out;
+	}
+	show_rom("after reset");
+	if (hw_errors("after reset")) {
+		LOG("(error bits right after reset are reported only)");
+	}
+	if (hap_level == 1) {
+		ok = true;
+	} else if (hap_level == 2) {
+		ok = rom_buzz();
+	} else {
+		ok = firmware_path();
+	}
+out:
+	park(ok ? "done" : "stopped");
+}
+
+void
+d1x_haptics_start(void)
+{
+	thread_t th;
+
+	if (!PE_parse_boot_argn("d2shaptic", &hap_level, sizeof(hap_level)) || hap_level == 0) {
+		return;
+	}
+	if (hap_level > 3) {
+		hap_level = 3;
+	}
+	(void)PE_parse_boot_argn("d2shaptic_ms", &hap_ms, sizeof(hap_ms));
+	(void)PE_parse_boot_argn("d2shaptic_idx", &hap_idx, sizeof(hap_idx));
+	(void)PE_parse_boot_argn("d2shaptic_level", &hap_rom_level, sizeof(hap_rom_level));
+	(void)PE_parse_boot_argn("d2shaptic_us", &hap_half_us, sizeof(hap_half_us));
+	(void)PE_parse_boot_argn("d2shaptic_verify", &hap_verify, sizeof(hap_verify));
+	if (hap_ms > MAX_MS) {
+		hap_ms = MAX_MS;
+	}
+	if (hap_ms && hap_ms < 10) {
+		hap_ms = 10;
+	}
+	if (hap_level == 2 && hap_ms == 0) {
+		hap_ms = 150;
+	}
+	if (hap_rom_level == 0 || hap_rom_level > SBOOT_LEVEL) {
+		hap_rom_level = SBOOT_LEVEL;
+	}
+	if (hap_half_us == 0 || hap_half_us > 50) {
+		hap_half_us = 2;
+	}
+	nanoseconds_to_absolutetime((uint64_t)hap_half_us * NSEC_PER_USEC, &g_half_ticks);
+	nanoseconds_to_absolutetime(2 * NSEC_PER_MSEC, &g_scl_ticks);
+	if (g_half_ticks == 0) {
+		g_half_ticks = 1;
+	}
+	if (kernel_thread_start(hap_thread, NULL, &th) != KERN_SUCCESS) {
+		LOG("no thread");
+		return;
+	}
+	thread_deallocate(th);
+}
