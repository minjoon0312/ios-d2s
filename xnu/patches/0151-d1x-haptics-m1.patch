+/*
+ * A file of the blob by the end of its path (e.g. "/cs40l25a.wmfw"), for
+ * kernel code that needs the bytes before (or without) the root, such as the
+ * haptics firmware (d1x_haptics.c). NULL if there is no valid blob or no such
+ * record. The data stays where the loader put it: nothing frees the range.
+ */
+const void *
+d2s_files_find(const char *suffix, uint32_t *len)
+{
+	size_t sl = strlen(suffix);
+	if (blob == NULL || blob_size < 16 || sl == 0 || memcmp(blob, "D2SFILE1", 8) != 0 ||
+	    *(const uint32_t *)(blob + 8) != 1) {
+		return NULL;
+	}
+	uint32_t count = *(const uint32_t *)(blob + 12), off = 16;
+	for (uint32_t i = 0; i < count; i++) {
+		const struct d2s_file_rec *r = (const struct d2s_file_rec *)(blob + off);
+		if (off + sizeof(*r) > blob_size || r->size < sizeof(*r) || r->size > blob_size - off ||
+		    r->path_len < 2 || sizeof(*r) + r->path_len > r->size) {
+			return NULL;
+		}
+		const char *path = (const char *)(r + 1);
+		uint32_t data_off = (uint32_t)sizeof(*r) + ((r->path_len + 7) & ~7u);
+		if (path[r->path_len - 1] != 0 || (uint64_t)data_off + r->data_len > r->size) {
+			return NULL;
+		}
+		size_t pl = r->path_len - 1;
+		if (pl >= sl && memcmp(path + pl - sl, suffix, sl) == 0) {
+			*len = r->data_len;
+			return (const uint8_t *)r + data_off;
+		}
+		off += r->size;
+	}
+	return NULL;
+}
