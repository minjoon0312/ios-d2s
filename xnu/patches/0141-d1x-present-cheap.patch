+/* Poll until (reg & bits) == want, at most limitUS: IOSleep(1) (d2sfb_spin=1: IODelay(100)). */
+static bool
+d2s_decon_poll(uint32_t off, uint32_t bits, uint32_t want, uint32_t limitUS)
+{
+	uint64_t t0 = mach_absolute_time(), now = t0, limit;
+
+	nanoseconds_to_absolutetime((uint64_t)limitUS * 1000, &limit);
+	for (;;) {
+		if ((*d2s_decon_reg(off) & bits) == want) {
+			return true;
+		}
+		if (now - t0 >= limit) {
+			d2s_st.timeouts++;
+			return false;
+		}
+		if (d2s_fb_spin) {
+			IODelay(100);
+		} else {
+			IOSleep(1);
+		}
+		d2s_st.polls++;
+		now = mach_absolute_time();
+	}
