+extern "C" uint64_t sweet_touch_down_time;     /* SweetHID.cpp */
+static uint64_t d2s_touch_down, d2s_touch_first, d2s_touch_prev;
+static uint32_t d2s_touch_presents;
+
+struct d2s_report {
+	bool stats, touch, touchChanged;
+	uint32_t presents, unchanged, rows, polls, timeouts, races, misses, touchPresents;
+	uint64_t swaps, waitAvg, waitMax, copyAvg, copyMax, touchFirst, touchLast;
+};
+
+static uint64_t
+d2s_us(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / 1000;
+}
+
+static void
+d2s_touch_track(uint64_t t0, uint64_t t2, bool changed, struct d2s_report *r)
+{
+	if (d2s_touch_down == 0) {
+		uint64_t t = __atomic_exchange_n(&sweet_touch_down_time, (uint64_t)0, __ATOMIC_RELAXED);
+		if (t == 0 || t < d2s_touch_prev) {
+			d2s_touch_prev = t0;    /* none, or a present after it was not watched */
+			return;
+		}
+		d2s_touch_down = t;
+		d2s_touch_first = 0;
+		d2s_touch_presents = 0;
+	}
+	d2s_touch_prev = t0;
+	if (d2s_touch_down > t0) {
+		return;                 /* came during this present: the next one is the first */
+	}
+	d2s_touch_presents++;
+	if (d2s_touch_first == 0) {
+		d2s_touch_first = t2;
+	}
+	if (changed || d2s_us(t2 - d2s_touch_down) >= 3000000) {
+		r->touch = true;
+		r->touchChanged = changed;
+		r->touchFirst = d2s_us(d2s_touch_first - d2s_touch_down) / 1000;
+		r->touchLast = d2s_us(t2 - d2s_touch_down) / 1000;
+		r->touchPresents = d2s_touch_presents;
+		d2s_touch_down = 0;
+	}
+}
+
+/* After a present, fPresentLock held: t0 start, t1 after the DECON wait, t2 after the copy. */
+static void
+d2s_present_done(uint64_t t0, uint64_t t1, uint64_t t2, struct d2s_report *r)
+{
+	bool changed = d2s_rows != 0 || d2s_full;
+	uint64_t wait = t1 - t0, copy = t2 - t1;
