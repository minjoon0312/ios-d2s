+	bzero(r, sizeof(*r));
+	if (d2s_st.start == 0) {
+		d2s_st.start = t0;
+		d2s_st.swaps = sweet_fb_swap_count;
+	}
+	d2s_st.presents++;
+	d2s_st.unchanged += changed ? 0 : 1;
+	d2s_st.rows += d2s_rows;
+	d2s_st.waitSum += wait;
+	d2s_st.waitMax = wait > d2s_st.waitMax ? wait : d2s_st.waitMax;
+	d2s_st.copySum += copy;
+	d2s_st.copyMax = copy > d2s_st.copyMax ? copy : d2s_st.copyMax;
+	if ((d2s_fb_log & 1) && d2s_us(t2 - d2s_st.start) >= 10000000) {
+		r->stats = true;
+		r->swaps = sweet_fb_swap_count - d2s_st.swaps;
+		r->presents = d2s_st.presents;
+		r->unchanged = d2s_st.unchanged;
+		r->rows = d2s_st.rows / d2s_st.presents;
+		r->waitAvg = d2s_us(d2s_st.waitSum / d2s_st.presents);
+		r->waitMax = d2s_us(d2s_st.waitMax);
+		r->copyAvg = d2s_us(d2s_st.copySum / d2s_st.presents);
+		r->copyMax = d2s_us(d2s_st.copyMax);
