+		    r->waitMax, r->polls, r->timeouts, r->races, r->misses);
+	}
+	if (r->touch) {
+		IOLog("SWEET FB: touch down -> first present %llu ms, %s %llu ms (%u presents)\n",
+		    r->touchFirst, r->touchChanged ? "first changed rows" : "no change by", r->touchLast,
+		    r->touchPresents);
