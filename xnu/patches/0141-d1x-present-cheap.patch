+/*
+ * 0141 d2sfb_dirty: copy only the panel rows whose source row changed since it was last
+ * copied. Each source row is summed with NH (Black, Halevi, Krawczyk, Krovetz, Rogaway,
+ * "UMAC: Fast and Secure Message Authentication", CRYPTO '99): the row as 64-bit words
+ * m[], zero-padded to whole pairs, H = sum of (m[2i] + k[2i]) * (m[2i+1] + k[2i+1]), adds
+ * mod 2^64, products and sum mod 2^128. NH is 2^-w almost universal (w = 64 here): for two
+ * different rows of the same length at most a 2^-64 fraction of the keys k give the same
+ * H, so with a key drawn at boot a changed row is missed with probability <= 2^-64. Costs
+ * 72 KB (sums and key) instead of a 10 MB copy of the last frame (XNU has 512 MiB), and
+ * each row is read once: an unchanged row costs that read and one 64x64->128 multiply per
+ * 16 bytes; a changed row is copied out of the cache right after it was summed.
+ * d2sfb_dirty=2 also keeps that 10 MB copy and checks every skipped row against it
+ * ("misses" in the stats, expected 0). Exact only while nothing but these copies writes
+ * the panel memory: the kernel console must be muted (sweetfb_noconsole/a5fb_noconsole,
+ * else every row is copied as before), and every other panel write clears d2s_sums_valid.
+ */
+#define D2S_SUM_ROWS    4096            /* panel rows */
+#define D2S_NH_KEYS     1024            /* 64-bit key words: rows up to 2048 pixels */
+static uint64_t d2s_nh_key[D2S_NH_KEYS];
+static struct d2s_row_sum {
+	uint64_t lo, hi;
+} d2s_sums[D2S_SUM_ROWS];
+static bool d2s_nh_ready, d2s_sums_valid, d2s_check_failed;
+static uint32_t d2s_sums_width;         /* source pixels per row the sums are for */
+static uint8_t *d2s_check;              /* d2sfb_dirty=2: each row as last copied */
+static size_t d2s_check_size;
+static uint32_t d2s_rows;               /* panel rows this present copied */
+static bool d2s_full;                   /* this present wrote the panel without row sums */
+
+static void
+d2s_row_nh(const uint32_t *px, uint32_t n, struct d2s_row_sum *out)
+{
+	const uint64_t *k = d2s_nh_key;
+	__uint128_t a = 0, b = 0;
+	uint32_t i = 0, j = 0;
+
+	for (; i + 8 <= n; i += 8, j += 4) {    /* 32 bytes: two pairs, two sums */
+		uint64_t m0, m1, m2, m3;
+		memcpy(&m0, px + i, 8);
+		memcpy(&m1, px + i + 2, 8);
+		memcpy(&m2, px + i + 4, 8);
+		memcpy(&m3, px + i + 6, 8);
+		a += (__uint128_t)(m0 + k[j]) * (m1 + k[j + 1]);
+		b += (__uint128_t)(m2 + k[j + 2]) * (m3 + k[j + 3]);
+	}
+	if (i < n) {                            /* 1-7 pixels left: zero-padded to whole pairs */
+		uint32_t tail[8] = { 0 };
+		memcpy(tail, px + i, (size_t)(n - i) * 4);
+		for (uint32_t t = 0; t < n - i; t += 4, j += 2) {
+			uint64_t m0, m1;
+			memcpy(&m0, tail + t, 8);
+			memcpy(&m1, tail + t + 2, 8);
+			a += (__uint128_t)(m0 + k[j]) * (m1 + k[j + 1]);
+		}
+	}
+	a += b;
+	out->lo = (uint64_t)a;
+	out->hi = (uint64_t)(a >> 64);
+}
+
+/* May this present skip rows of n source pixels? Sets the key up once. fPresentLock held. */
+static bool
+d2s_dirty_ready(uint32_t ph, uint32_t n)
+{
+	if (d2s_fb_dirty == 0 || !sweet_console_muted || ph > D2S_SUM_ROWS ||
+	    2 * ((n + 3) / 4) > D2S_NH_KEYS) {
+		return false;
+	}
+	if (!d2s_nh_ready) {
+		/* splitmix64 seeded from the clock: any key not derived from the pixels will do */
+		uint64_t x = mach_absolute_time() ^ 0x6a09e667f3bcc908ULL;
+		for (uint32_t i = 0; i < D2S_NH_KEYS; i++) {
+			x += 0x9e3779b97f4a7c15ULL;
+			uint64_t z = x;
+			z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+			z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+			d2s_nh_key[i] = z ^ (z >> 31);
+		}
+		d2s_nh_ready = true;
+	}
+	if (n != d2s_sums_width) {
+		d2s_sums_width = n;
+		d2s_sums_valid = false;
+	}
+	size_t need = (size_t)ph * n * 4;
+	if (d2s_fb_dirty == 2 && d2s_check_size != need && !d2s_check_failed) {
+		if (d2s_check != NULL) {
+			IOFreeData(d2s_check, d2s_check_size);
+		}
+		d2s_check = (uint8_t *)IOMallocData(need);
+		d2s_check_size = d2s_check != NULL ? need : 0;
+		d2s_check_failed = d2s_check == NULL;
+		d2s_sums_valid = false;
+		IOLog("SWEET FB: dirty rows checked against a %u KiB copy%s\n", (uint32_t)(need >> 10),
+		    d2s_check != NULL ? "" : ": no memory, not checked");
+	}
+	return true;
+}
