+/* exynos_pcie_establish_link() [rc]1217-1344, without IA (only for L1.2 exit, [rc]1413-1486) and interrupts */
+static int
+m2_link(void)
+{
+	uint32_t v;
+	bool up = false, rc_ok = true;
+	unsigned t;
+
+	step("M2 link");
+	sv.link = true;
+	for (t = 1; t <= LINK_TRIES && !up && !stop_now(); t++) {
+		set_clr(&b_pcs, PCS_ELECIDLE, 0, 1U << 3);              /* [rc]1226-1230 */
+		wr(&b_elbi, ELBI_SOFT_CORE_RESET, 0);                   /* [rc]1232-1234 */
+		spin_us(20);
+		wr(&b_elbi, ELBI_SOFT_CORE_RESET, 1);
+		set_clr(&b_gpf2, BANK_DAT, 0, 1U << PIN_PERST);         /* PERST# released, 18-20 ms [rc]1236-1240 */
+		IOSleep(20);
+		set_clr(&b_elbi, ELBI_APP_REQ_EXIT_L1_MODE, 0, 0x1U | 0x10U);   /* [rc]1243-1246 */
+		wr(&b_elbi, ELBI_LINKDOWN_RST_SEL, 1U << 1);            /* [rc]1247-1248 */
+		set_clr(&b_elbi, ELBI_QCH_SEL, 0xfffU, 0);              /* no clock gating while training [rc]1250-1259 */
+		phy_config();                                           /* [rc]1404-1411 */
+		set_clr(&b_elbi, ELBI_SW_WAKE, 1U << 1, 0);             /* bus number enable [rc]1488-1491 */
+		dbi_open();
+		rc_ok = rc_setup();                                     /* [rc]1268-1269 */
+		dbi_close();                                            /* [rc]1271-1274 */
+		if (!rc_ok) {
+			break;
+		}
+		if (t == 1) {
+			LOG("M2 phy: sysreg %08x %08x; phy 0=%02x 4=%02x 80=%02x 15c=%02x (want 01 e1 c0 7e); "
+			    "pcs 100=%02x (want 87)", rd(&b_sysreg, 0), rd(&b_sysreg, 0xc), rd(&b_phy, 0) & 0xffU,
+			    rd(&b_phy, 4) & 0xffU, rd(&b_phy, PHY_CMN_PWRDN) & 0xffU, rd(&b_phy, PHY_TRSV_PWRDN) & 0xffU,
+			    rd(&b_pcs, PCS_REFCLK_OUT) & 0xffU);
+		}
+		LOG("M2 before LTSSM: D-state %u, LTSSM %#x", rd(&b_elbi, ELBI_PM_DSTATE) & 7U, ltssm());
+		up = train(t);
+		if (!up) {
+			/* PERST# low, LTSSM off [rc]1300-1309; 1 ms keeps PERST# low longer than T_PERST (100 us) */
+			set_clr(&b_gpf2, BANK_DAT, 1U << PIN_PERST, 0);
+			wr(&b_elbi, ELBI_LTSSM_EN, 0);
+			IOSleep(1);
+		}
+	}
+	if (!rc_ok) {
+		return ENXIO;
+	}
+	if (!up) {
+		LOG("M2 FAIL: no link after %u tries", t - 1);
+		history();
+		dump("M2 fail", &b_elbi, elbi_regs, N(elbi_regs));
+		dump("M2 fail", &b_pcs, pcs_regs, N(pcs_regs));
+		return stop_now() ? ECANCELED : ETIMEDOUT;
+	}
+
+	step("M2 link up");
+	wr(&b_elbi, ELBI_L12ERR_CTRL, 0);                               /* NCLK stays on while linked [rc]2516-2519 */
+	v = rd(&b_dbi, DBI_LNKCTL) >> 16;
+	LOG("link up: LTSSM %#x %s, Gen%u x%u (want Gen1 x1, max-link-speed 1)", ltssm(), ltssm_name(ltssm()),
+	    v & 0xfU, (v >> 4) & 0x3fU);
+	wr(&b_elbi, ELBI_IRQ_PULSE, rd(&b_elbi, ELBI_IRQ_PULSE));       /* stale pulses [rc]1331-1332 */
+	sv.atu = true;
+	atu(1, ATU_TYPE_CFG0, (uint32_t)CFG_PA, 0x1000, 1U << 24);      /* bus 1, dev 0, fn 0 [rc]1338-1339 */
+	atu(0, ATU_TYPE_MEM, (uint32_t)MEM_PA, (uint32_t)MEM_SIZE, (uint32_t)MEM_PA);  /* [rc]1340 */
+	wr(&b_dbi, DBI_ATU_VIEWPORT, 1);
+	v = rd(&b_dbi, DBI_ATU_CR2);
+	LOG("atu: region 1 CR2 %08x (want 80000000), CR1 %08x, base %08x, limit %08x, target %08x", v,
+	    rd(&b_dbi, DBI_ATU_CR1), rd(&b_dbi, DBI_ATU_BASE), rd(&b_dbi, DBI_ATU_LIMIT), rd(&b_dbi, DBI_ATU_TARGET));
+	dump("M2 link up", &b_dbi, dbi_regs, N(dbi_regs));
+	if (v != ATU_ENABLE) {
+		LOG("M2 FAIL: the iATU does not take the CFG0 region");
+		return ENXIO;
+	}
+	return stop_now() ? ECANCELED : 0;
+}
+
+static int
+m2_ids(void)
+{
+	uint32_t id = ~0U, cls, cmd, bar0, bar2, chipid, caps;
+	uint64_t s0, s2;
+	bool w0, w2;
+
+	step("M2 config");
+	if (!map_blk(&b_cfg)) {
+		return ENOMEM;
+	}
+	/* 100 ms after the link is up (PCIe base spec 6.6.1), then while it reads all ones or CRS, up to 1 s ([y2s]661-673) */
+	IOSleep(100);
+	for (unsigned i = 0; i < 100 && !stop_now(); i++) {
+		id = rd(&b_cfg, 0x00);
+		if (id != ~0U && (id & 0xffffU) != 0x0001U) {
+			break;
+		}
+		IOSleep(10);
+	}
+	cls = rd(&b_cfg, 0x08);
+	cmd = rd(&b_cfg, 0x04);
+	LOG("endpoint 01:00.0: id %04x:%04x (want 14e4:4475), class %06x rev %02x, header %02x, subsystem %08x, "
+	    "cmd/status %08x", id & 0xffffU, id >> 16, cls >> 8, cls & 0xffU, (rd(&b_cfg, 0x0c) >> 16) & 0x7fU,
+	    rd(&b_cfg, 0x2c), cmd);
+	if ((id & 0xffffU) != 0x14e4U) {
+		LOG("M2 FAIL: %s", id == ~0U ? "the endpoint does not answer configuration reads" : "not a Broadcom device");
+		return ENODEV;
+	}
+	if ((id >> 16) != 0x4475U) {
+		LOG("M2: device %04x is not the expected 4475 (BCM4375_D11AX_ID); going on", id >> 16);
+	}
+	if (cmd & 0x6U) {
+		wr(&b_cfg, 0x04, cmd & 0xfff9U);                        /* sizing needs memory decode off; status untouched */
+	}
+	s0 = bar_size(0x10, &w0);
+	s2 = bar_size(0x18, &w2);
+	LOG("endpoint BARs: BAR0 %s %llu KB, BAR2 %s %llu KB (y2sios: 32 KB and 4 MB, 64-bit)", w0 ? "64-bit" : "32-bit",
+	    s0 >> 10, w2 ? "64-bit" : "32-bit", s2 >> 10);
+	if (s0 < 0x1000 || s0 > 0x400000) {
+		LOG("M2 FAIL: BAR0 size %llu does not fit", s0);
+		return ENXIO;
+	}
+
+	step("M2 chip id");
+	/* the root port forwards the window (bridge memory base/limit, 1 MB granules; [y2s] redwood_bcm4375.c 1671) */
+	wr(&b_dbi, DBI_MEM_WIN, ((((uint32_t)(MEM_PA + MEM_SIZE - 1) >> 16) & 0xfff0U) << 16) |
+	    (((uint32_t)MEM_PA >> 16) & 0xfff0U));
+	bar0 = (uint32_t)MEM_PA;
+	wr(&b_cfg, 0x10, bar0);
+	if (w0) {
+		wr(&b_cfg, 0x14, 0);
+	}
+	/* BAR2 (TCM) is not used here; placed after BAR0 when it fits, so that no BAR decodes address 0 */
+	bar2 = 0;
+	if (s2 != 0 && s2 <= MEM_SIZE) {
+		uint64_t at = ((uint64_t)MEM_PA + s0 + s2 - 1) & ~(s2 - 1);
+		if (at + s2 <= (uint64_t)MEM_PA + MEM_SIZE) {
+			bar2 = (uint32_t)at;
+			wr(&b_cfg, 0x18, bar2);
+			if (w2) {
+				wr(&b_cfg, 0x1c, 0);
+			}
+		}
+	}
+	wr(&b_cfg, 0x04, (rd(&b_cfg, 0x04) & 0xfff8U) | 0x2U);         /* memory decode only: no bus master, no DMA */
+	wr(&b_cfg, EP_BAR0_WINDOW, SI_ENUM_BASE);                       /* the 4 KB window onto ChipCommon */
+	LOG("BARs: BAR0 %08x, BAR2 %08x, cmd %04x, bridge window %08x, BAR0 window %08x (want 18000000)",
+	    rd(&b_cfg, 0x10), rd(&b_cfg, 0x18), rd(&b_cfg, 0x04) & 0xffffU, rd(&b_dbi, DBI_MEM_WIN),
+	    rd(&b_cfg, EP_BAR0_WINDOW));
+	if (rd(&b_cfg, 0x10) != bar0 || rd(&b_cfg, EP_BAR0_WINDOW) != SI_ENUM_BASE) {
+		LOG("M2 FAIL: BAR0 or its window did not take the value");
+		return ENXIO;
+	}
+	if (!map_blk(&b_bar0)) {
+		return ENOMEM;
+	}
+	chipid = rd(&b_bar0, 0x0);
+	caps = rd(&b_bar0, 0x4);
+	LOG("chipcommon chip id %08x: BCM%04x rev %u package %u, type %u; capabilities %08x (want 4375 rev 5 = B1)",
+	    chipid, chipid & 0xffffU, (chipid >> 16) & 0xfU, (chipid >> 20) & 0xfU, chipid >> 28, caps);
+	if ((chipid & 0xffffU) != 0x4375U) {
+		LOG("M2 FAIL: not the BCM4375");
+		return ENODEV;
+	}
+	LOG("M2 PASS: link up, %04x:%04x, BCM4375 rev %u answers through BAR0", id & 0xffffU, id >> 16,
+	    (chipid >> 16) & 0xfU);
+	return 0;
+}
+
+/* exynos_pcie_send_pme_turn_off() [rc]2700-2767, one round */
+static void
+pme_turn_off(void)
+{
+	bool ack, l23;
+
+	wr(&b_elbi, ELBI_APP_REQ_EXIT_L1, 1);
+	set_clr(&b_elbi, ELBI_APP_REQ_EXIT_L1_MODE, 0x1U, 0x10U);
+	wr(&b_elbi, ELBI_XMIT_PME_TURNOFF, 1);
+	ack = wait_bits(&b_elbi, ELBI_IRQ_PULSE, IRQ_RADM_PM_TO_ACK, IRQ_RADM_PM_TO_ACK, 20000);
+	wr(&b_elbi, ELBI_XMIT_PME_TURNOFF, 0);
+	l23 = wait_bits(&b_elbi, ELBI_RDLH_LINKUP, 0x1fU, 0x15U, 20000);
+	LOG("off: PME_Turn_Off %s, %s (LTSSM %#x)", ack ? "acked" : "not acked", l23 ? "L2/L3 ready" : "no L2/L3 ready",
+	    ltssm());
+}
+
+/*
+ * exynos_pcie_poweroff() [rc]2586-2697, then dhd_wlan_power(0) [dhd]131: only what M2 changed, in reverse.
+ * Sysreg, PMU and clocks go back to what S-Boot left (Samsung leaves them on); PERST# stays an output, low, as
+ * Samsung's "idle" pin state ([d1x]2409); REG_ON an output, low.
+ */
+static void
+power_off(int error)
+{
+	step("off");
+	LOG("off after %s (error %d)", error ? "a failure" : "M2", error);
+	wl_abort = false;               /* the power-off itself must run (each access is still checked) */
+	wl_bug = false;
+	if (sv.link) {
+		/* no DBI access from here on: with the link leaving L0 Samsung only reaches it with RX elec idle ignored */
+		if (sv.atu && ltssm_up(ltssm())) {
+			pme_turn_off();
+		}
+		set_clr(&b_elbi, ELBI_HISTORY_CHECK, 3U, 0);   /* [rc]2621-2624 */
+		set_clr(&b_gpf2, BANK_DAT, 1U << PIN_PERST, 0); /* [rc]2626 */
+		wr(&b_elbi, ELBI_LTSSM_EN, 0);                  /* [rc]2631-2632 */
+	}
+	if (sv.phy) {
+		phy_pwrdn();                                    /* [rc]2635-2641 */
+		wr(&b_elbi, ELBI_L12ERR_CTRL, 1U << 2);         /* [rc]2679-2683 */
+	}
+	if (sv.sysreg) {
+		wr(&b_sysreg, 0xc, sv.sysreg_c);
+		wr(&b_sysreg, 0x0, sv.sysreg0);
+	}
+	if (sv.pmu) {
+		wr(&b_pmu, 0, sv.pmu_phy);
+	}
+	if (sv.clocks) {
+		for (unsigned i = N(pcie_gates); i-- > 0;) {
+			wr(&b_fsys1, pcie_gates[i].off, sv.gate[i]);
+		}
+		if (sv.umux) {
+			wr(&b_fsys1, UMUX_OFF, sv.umux_val);
+			(void)wait_bits(&b_fsys1, UMUX_OFF, UMUX_BUSY, 0, 1000);
+		}
+		wr(&b_top_gate, 0, sv.top_gate);
+	}
+	if (sv.reg_on) {
+		pin_out(&b_gpg0, PIN_REG_ON, 0);
+	}
+	if (sv.pins) {
+		pin_out(&b_gpf2, PIN_PERST, 0);
+		pin_set_field(&b_gpf2, BANK_CON, PIN_CLKREQ, (sv.gpf2[0] >> (PIN_CLKREQ * 4U)) & 0xfU);
+		pin_set_field(&b_gpf2, BANK_PUD, PIN_CLKREQ, (sv.gpf2[2] >> (PIN_CLKREQ * 4U)) & 0xfU);
+		pin_set_field(&b_gpf2, BANK_DRV, PIN_CLKREQ, (sv.gpf2[3] >> (PIN_CLKREQ * 4U)) & 0xfU);
+		log_pins("off:");
+	}
+	LOG("off: done%s: pmu %08x, top gate %08x, user mux %08x%s", wl_bug ? " (with refused accesses)" : "",
+	    rd(&b_pmu, 0), rd(&b_top_gate, 0), rd(&b_fsys1, UMUX_OFF), sv.clocks ? "; gates as found" : "");
+}
+
+static int
+m2(void)
+{
+	int e;
+
+	if ((e = m2_pins()) != 0 || (e = m2_clocks()) != 0 || (e = m2_power()) != 0 || (e = m2_link()) != 0) {
+		return e;
+	}
+	return m2_ids();
+}
+
+/* ------------------------------------------------------------------------ */
+/* The Wi-Fi DMA pool (milestone 4 uses it; checked here)                    */
+
+#define POOL_PA_DEFAULT         0x99000000U
+#define POOL_SIZE_DEFAULT       0x02000000U     /* 32 MiB */
+#define POOL_GRANULE            0x10000U
+#define POOL_MAX                0x04000000U
+#define POOL_PER_GRANULE        3U
+
+static uint32_t pool_saved[POOL_MAX / POOL_GRANULE * POOL_PER_GRANULE];
+static uint32_t pool_pa, pool_size;
+static vm_offset_t pool_va;
+static bool pool_ok;
+
+/* The first low DRAM bank (d1x /proc/device-tree: 0x80000000 + 0x3AB00000) and what in it is not ours */
+#define LOW_BANK_BASE           0x80000000ULL
+#define LOW_BANK_END            0xbab00000ULL
+static const struct {
+	uint32_t        base, size;
+	const char      *what;
+} pool_avoid[] = {
+	{ 0x80000000U, 0x00001000U, "sec_debug_magic" },                /* [dt]2892 */
+	{ 0x87000000U, 0x00200000U, "el2 (hypervisor)" },
+	{ 0x91200000U, 0x00001000U, "mm_debug" },                        /* [dt]2887 */
+	{ 0x96000000U, 0x03000000U, "secure camera ION heaps (TZ-protectable)" },       /* [d1x]2594, 2602 */
+};
+#define DISPLAY_AREA_BASE       0x9b000000ULL   /* the display work's buffers, upward */
+#define DISPLAY_AREA_END        0xb4800000ULL   /* end of Android's camera carve-out [d1x]2609 */
+
+static const char *
+pool_bad(uint64_t base, uint64_t size)
+{
+	if ((base & (POOL_GRANULE - 1)) || (size & (POOL_GRANULE - 1)) || size < 0x100000U || size > POOL_MAX) {
+		return "base and size must be 64 KiB multiples, size 1 to 64 MiB";
+	}
+	if (base < LOW_BANK_BASE || base + size > LOW_BANK_END) {
+		return "outside the first low DRAM bank 0x80000000-0xbab00000";
+	}
+	for (unsigned i = 0; i < N(pool_avoid); i++) {
+		if (base < (uint64_t)pool_avoid[i].base + pool_avoid[i].size && pool_avoid[i].base < base + size) {
+			return pool_avoid[i].what;
+		}
+	}
+	return NULL;
+}
+
+static uint32_t
+pool_off(uint32_t i)                    /* each granule's first, middle and last word */
+{
+	static const uint32_t in[POOL_PER_GRANULE] = { 0, POOL_GRANULE / 2, POOL_GRANULE - 4 };
+
+	return (i / POOL_PER_GRANULE) * POOL_GRANULE + in[i % POOL_PER_GRANULE];
+}
+
+static uint32_t
+pool_pattern(uint32_t pa, uint32_t salt)        /* depends on the address: aliasing shows */
+{
+	uint32_t x = pa ^ salt;
+
+	x ^= x >> 16;
+	x *= 0x7feb352dU;
+	x ^= x >> 15;
+	x *= 0x846ca68bU;
+	x ^= x >> 16;
+	return x;
+}
+
+static volatile uint32_t *
+pool_word(uint32_t i)
+{
+	return (volatile uint32_t *)(pool_va + pool_off(i));
+}
+
+static void
+pool_check(void)
+{
+	uint32_t n, zero = 0, ones = 0, digest = 0, bad = 0, changed = 0, first_bad = ~0U, v;
+	const char *why;
+
+	step("pool");
+	pool_pa = POOL_PA_DEFAULT;
+	pool_size = POOL_SIZE_DEFAULT;
+	PE_parse_boot_argn("d2swlan_pool", &pool_pa, sizeof(pool_pa));
+	PE_parse_boot_argn("d2swlan_pool_size", &pool_size, sizeof(pool_size));
+	if (pool_size == 0) {
+		LOG("pool: none (d2swlan_pool_size=0)");
+		return;
+	}
+	why = pool_bad(pool_pa, pool_size);
+	if (why != NULL) {
+		LOG("pool %#x + %#x refused: %s", pool_pa, pool_size, why);
+		return;
+	}
+	if ((uint64_t)pool_pa < DISPLAY_AREA_END && DISPLAY_AREA_BASE < (uint64_t)pool_pa + pool_size) {
+		LOG("pool: note, %#x + %#x overlaps the display buffers' area from 0x9b000000", pool_pa, pool_size);
+	}
+	/* uncached (normal non-cacheable), from kernel_map: the 8 MB io_submap of ml_io_map() cannot take 32 MB ([y2s]697-705) */
+	pool_va = ml_io_map_unmappable(pool_pa, pool_size, VM_WIMG_WCOMB);
+	if (pool_va == 0) {
+		LOG("pool: not mapped");
+		return;
+	}
+	n = pool_size / POOL_GRANULE * POOL_PER_GRANULE;
+	/* 1. what is there, kept to be put back */
+	for (uint32_t i = 0; i < n; i++) {
+		v = *pool_word(i);
+		pool_saved[i] = v;
+		zero += v == 0;
+		ones += v == ~0U;
+		digest = digest * 31U + v;
+	}
+	LOG("pool %#x-%#x at %#lx uncached: %u sample words, %u zero, %u all ones, digest %08x", pool_pa,
+	    pool_pa + pool_size - 1, (unsigned long)pool_va, n, zero, ones, digest);
+	/* 2. two address-dependent patterns written and read back */
+	for (uint32_t pass = 0; pass < 2; pass++) {
+		uint32_t salt = pass ? 0x5a5aa5a5U : 0xa5a55a5aU;
+		for (uint32_t i = 0; i < n; i++) {
+			*pool_word(i) = pool_pattern(pool_pa + pool_off(i), salt);
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (uint32_t i = 0; i < n; i++) {
+			if (*pool_word(i) != pool_pattern(pool_pa + pool_off(i), salt)) {
+				bad++;
+				first_bad = first_bad == ~0U ? pool_pa + pool_off(i) : first_bad;
+			}
+		}
+	}
+	/* 3. does anything else write here? */
+	IOSleep(2000);
+	wl_beat = mach_absolute_time();
+	for (uint32_t i = 0; i < n; i++) {
+		if (*pool_word(i) != pool_pattern(pool_pa + pool_off(i), 0x5a5aa5a5U)) {
+			changed++;
+			first_bad = first_bad == ~0U ? pool_pa + pool_off(i) : first_bad;
+		}
+	}
+	/* 4. put back what was there */
+	for (uint32_t i = 0; i < n; i++) {
+		*pool_word(i) = pool_saved[i];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	pool_ok = bad == 0 && changed == 0;
+	if (pool_ok) {
+		LOG("pool PASS: %#x + %#x, %u words x 2 patterns read back right, none changed in 2 s; contents put back",
+		    pool_pa, pool_size, n);
+	} else {
+		LOG("pool FAIL: %u read back wrong, %u changed by someone else in 2 s, first at %#x; contents put back",
+		    bad, changed, first_bad);
+	}
+}
+
+/* For milestone 4: the pool, once this boot's check passed. */
+int
+d2s_wlan_pool(uint64_t *pa, vm_offset_t *va, uint32_t *size)
+{
+	if (!pool_ok) {
+		return ENOENT;
+	}
+	*pa = pool_pa;
+	*va = pool_va;
+	*size = pool_size;
+	return 0;
+}
+
+/* ------------------------------------------------------------------------ */
+
+static void
+wlan_thread(__unused void *arg, __unused wait_result_t wres)
+{
+	uint32_t wait_s = 15, pooltest = wl_level >= 2 ? 1 : 0, ms;
+	int e;
+
+	PE_parse_boot_argn("d2swlan_wait", &wait_s, sizeof(wait_s));
+	PE_parse_boot_argn("d2swlan_pooltest", &pooltest, sizeof(pooltest));
+	if (wait_s > 600) {
+		wait_s = 600;
+	}
+	/* Nothing until the root is mounted: UFS (same FSYS1 bus) is up and the root mount never waits on this. */
+	for (ms = 0; rootvnode == NULLVP && ms < 600000; ms += 100) {
+		IOSleep(100);
+	}
+	if (rootvnode == NULLVP) {
+		LOG("no root after 600 s: nothing done");
+		goto out;
+	}
+	LOG("root mounted (%u ms after start): M1", ms);
+	for (unsigned i = 0; i < N(m1_blocks); i++) {
+		if (!map_blk(m1_blocks[i])) {
+			goto out;
+		}
+	}
+	wl_active = true;
+	m1_look();
+	wl_active = false;
+	if (wl_level >= 2 && !wl_bug_seen) {
+		LOG("M2 in %u s (d2swlan_wait)", wait_s);
+		IOSleep(wait_s * 1000U);
+		wl_m2_start = mach_absolute_time();
+		wl_m2 = true;
+		wl_active = true;
+		e = m2();
+		wl_m2 = false;          /* the power-off runs whatever the budget */
+		power_off(e);
+		wl_active = false;
+	}
+	if (pooltest && !wl_bug_seen) {
+		wl_active = true;
+		pool_check();
+		wl_active = false;
+	}
+out:
+	wl_active = false;
+	wl_done = true;
+	LOG("done");
+}
+
+void
+d2s_wlan_start(void)
+{
+	static bool started;
+	thread_t thread;
+
+	if (started) {
+		return;
+	}
+	started = true;
+	if (!PE_parse_boot_argn("d2swlan", &wl_level, sizeof(wl_level)) || wl_level == 0) {
+		return;
+	}
+	if (wl_level > 2) {
+		LOG("d2swlan=%u: this build has levels 1 and 2; running 2", wl_level);
+		wl_level = 2;
+	}
+	LOG("d2swlan=%u: %s; waiting for the root file system", wl_level,
+	    wl_level == 1 ? "M1, read only" : "M1, then M2: power, link, chip id, power off");
+	wl_beat = mach_absolute_time();
+	if (kernel_thread_start(wlan_thread, NULL, &thread) != KERN_SUCCESS) {
+		LOG("no thread: nothing done");
+		return;
+	}
+	thread_deallocate(thread);
+	if (kernel_thread_start(wlan_watchdog, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		LOG("no watchdog thread (the steps are bounded anyway)");
+	}
+}
+
+#else
+void
+d2s_wlan_start(void)
+{
+}
+
+int
+d2s_wlan_pool(__unused uint64_t *pa, __unused vm_offset_t *va, __unused uint32_t *size)
+{
+	return ENOTSUP;
+}
+#endif /* D2S */
