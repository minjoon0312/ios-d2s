@@ -23,7 +27,8 @@
 #include <sys/fcntl.h>
 #include <sys/mount.h>
 #include <sys/vnode.h>
-#include <sys/vnode_internal.h>	/* vnode_setsize, rootvnode */
+#include <sys/vnode_internal.h>	/* vnode_setsize, rootvnode, vn_create */
+#include <sys/namei.h>			/* NDINIT, namei (0164 mkdir) */
 #include <sys/kauth.h>
 #include <sys/proc.h>
 #include <kern/thread.h>
@@ -55,6 +60,89 @@ static const uint8_t *blob;
 static uint32_t blob_size;
 static volatile int files_state;	/* 0 working, 1 done (or nothing to do) */
 
+/* one directory, mode 0755, root:wheel (mkdir1at without the syscall parts); EEXIST if there */
+static int
+mkdir_one(const char *path, vfs_context_t ctx)
+{
+	struct nameidata nd;
+	struct vnode_attr va;
+	vnode_t vp = NULLVP;
+	int err;
+
+	NDINIT(&nd, CREATE, OP_MKDIR, LOCKPARENT, UIO_SYSSPACE, CAST_USER_ADDR_T(path), ctx);
+	nd.ni_cnd.cn_flags |= WILLBEDIR;
+	err = namei(&nd);
+	if (err) {
+		return err;
+	}
+	if (nd.ni_vp != NULLVP) {
+		vnode_put(nd.ni_vp);
+		err = EEXIST;
+	} else {
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_type, VDIR);
+		VATTR_SET(&va, va_mode, 0755);
+		VATTR_SET(&va, va_uid, 0);
+		VATTR_SET(&va, va_gid, 0);
+		err = vn_create(nd.ni_dvp, &vp, &nd, &va, 0, 0, NULL, ctx);
+		if (!err && vp != NULLVP) {
+			vnode_put(vp);
+		}
+	}
+	nameidone(&nd);		/* before the parent's put, as mkdir1at */
+	vnode_put(nd.ni_dvp);
+	return err;
+}
+
+/*
+ * mkdir -p of the directory part of path (0164). Only called when opening the
+ * file failed with ENOENT. Components that exist are passed over (a symlink in
+ * the way, such as /var, is followed by the lookup); one that exists and is
+ * not a directory stops it with ENOTDIR.
+ */
+static char mkdir_buf[MAXPATHLEN];	/* only the install thread uses it */
+
+static int
+mkdir_parents(const char *path, vfs_context_t ctx)
+{
+	size_t n = strlcpy(mkdir_buf, path, sizeof(mkdir_buf));
+	int made = 0;
+
+	if (n >= sizeof(mkdir_buf)) {
+		return ENAMETOOLONG;
+	}
+	for (char *c = mkdir_buf + 1; *c; c++) {
+		if (*c != '/') {
+			continue;
+		}
+		*c = '\0';
+		vnode_t dvp = NULLVP;
+		int err = vnode_lookup(mkdir_buf, 0, &dvp, ctx);
+		if (err == 0) {
+			bool dir = vnode_isdir(dvp);
+			vnode_put(dvp);
+			if (!dir) {
+				printf("D2S FILES: %s is in the way and not a directory\n", mkdir_buf);
+				return ENOTDIR;
+			}
+		} else if (err == ENOENT) {
+			err = mkdir_one(mkdir_buf, ctx);
+			if (err && err != EEXIST) {
+				printf("D2S FILES: mkdir %s: error %d\n", mkdir_buf, err);
+				return err;
+			}
+			if (!err) {
+				made++;
+				printf("D2S FILES: %s (directory, mode 755, 0:0): made\n", mkdir_buf);
+			}
+		} else {
+			return err;
+		}
+		*c = '/';
+	}
+	return made ? 0 : ENOENT;	/* nothing was missing: the ENOENT was not ours to fix */
+}
+
