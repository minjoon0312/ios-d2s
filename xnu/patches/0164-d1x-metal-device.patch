+/* ---- the Metal device (0164, boot-arg d2smetal) ----------------------- */
+
+/*
+ * How iOS 16.7.16 finds a GPU for Metal (Metal.framework of the 20H392 shared cache, read
+ * on the Mac): _MTLRegisterDevices (0x181b144c8) runs IOServiceGetMatchingServices(
+ * IOServiceMatching("IOAcceleratorES")) and, for each service, getMetalPluginClassForService
+ * (0x181a3c7c8): IORegistryEntryCreateCFProperty "MetalPluginName" (must be a CFString) ->
+ * +[NSBundle bundleWithPath:] "/System/Library/Extensions/" + name + ".bundle", then
+ * "MetalPluginClassName" -> -[NSBundle classNamed:] (else -principalClass), which must be a
+ * subclass of _MTLDevice. Then [[cls alloc] initWithAcceleratorPort:service] and
+ * MTLAddDevice. Nothing else is read. MTLCreateSystemDefaultDevice() and MTLCopyAllDevices()
+ * both run this once per process.
+ *
+ * So the kernel publishes one IOAcceleratorES service, a child of D2SGPU, whose two names
+ * point at y2sios's driver (ios-d2s/tools/d2s-metal: RedwoodMetal.bundle, class
+ * RedwoodMetalDevice; it reaches the GPU through libredwoodair and D2SGPU, not through this
+ * service, so the service has no user client). As in the S8 port (s8gpu_publish_metal) and
+ * y2sios (MiniIOMobileFramebuffer.cpp, metal=1), with one difference: the two names are not
+ * in the property table. They are answered per process, by name, from copyProperty and
+ * serializeProperties, so a test process can have the device while the window server does
+ * not. On 16.7.16 CoreAnimation takes the Metal road as soon as backboardd's Metal has a
+ * device (S8 boots 47 to 49), so who sees the names IS the switch:
+ *
+ *   d2smetal=0 (default)  nothing published, as before 0164
+ *   d2smetal=1            published; the names are shown only to the processes listed in
+ *                         d2smtlp=NAME,NAME (default "timed", the mtltest host). Everyone else,
+ *                         backboardd included, sees an IOAcceleratorES without them, which
+ *                         Metal passes over: no device, CoreAnimation stays on the CPU.
+ *                         (QuartzCore's CAMetalContextCreate also stops polling for an
+ *                         IOAcceleratorES for 30 s, ios-guacamole 0088.)
+ *   d2smetal=2            as 1, plus backboardd: CoreAnimation draws through RedwoodMetal
+ *   d2smetal=3            every process (apps, SpringBoard, WebKit)
+ *
+ * A process keeps the answer of its first read (Metal registers once per process). Before a
+ * process is shown the names, the boot file install (bsd/kern/d2s_files.c, which writes the
+ * bundle) is waited for, up to 15 s, so NSBundle never opens a half-written bundle. While
+ * the GPU core is not up, nobody is shown the names.
+ */
+extern "C" bool d2s_files_wait(uint32_t ms);
+
+#define D2S_METAL_NAME_KEY	"MetalPluginName"
+#define D2S_METAL_CLASS_KEY	"MetalPluginClassName"
+#define D2S_METAL_BUNDLE	"RedwoodMetal"		/* /System/Library/Extensions/RedwoodMetal.bundle */
+#define D2S_METAL_CLASS		"RedwoodMetalDevice"
+
+static uint32_t d2s_metal_level;
+static char d2s_metal_procs[128] = "timed";
+static volatile uint32_t d2s_metal_said;
+
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+class D2SMetalAccelerator : public IOAcceleratorES {
+	OSDeclareDefaultStructors(D2SMetalAccelerator);
+
+public:
+	using IOAcceleratorES::copyProperty;
+	OSObject *copyProperty(const char *aKey) const APPLE_KEXT_OVERRIDE;
+	OSObject *copyProperty(const OSString *aKey) const APPLE_KEXT_OVERRIDE;
+	OSObject *copyProperty(const OSSymbol *aKey) const APPLE_KEXT_OVERRIDE;
+	bool serializeProperties(OSSerialize *s) const APPLE_KEXT_OVERRIDE;
+
+private:
+	OSObject *plugin(const char *aKey, bool *handled) const;
+};
+
+OSDefineMetaClassAndStructors(D2SMetalAccelerator, IOAcceleratorES);
+
+static bool
+d2s_metal_listed(const char *who)
+{
+	size_t n = strlen(who);
+	for (const char *t = d2s_metal_procs; n != 0 && *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && strncmp(t, who, n) == 0) {
+			return true;
+		}
+		if (end == NULL) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
+/* whether the calling process is shown the two names; its name goes to who */
+static bool
+d2s_metal_shown(char *who, int size)
+{
+	proc_selfname(who, size);
+	if (d2s_metal_level >= 3) {
+		return true;
+	}
+	if (d2s_metal_level >= 2 && strcmp(who, "backboardd") == 0) {
+		return true;
+	}
+	return d2s_metal_listed(who);
+}
+
+/* the answer for one of the two keys (handled = it was one of them), retained; NULL = not shown */
+OSObject *
+D2SMetalAccelerator::plugin(const char *aKey, bool *handled) const
+{
+	bool isName = aKey != NULL && strcmp(aKey, D2S_METAL_NAME_KEY) == 0;
+	char who[32] = "?";
+
+	*handled = isName || (aKey != NULL && strcmp(aKey, D2S_METAL_CLASS_KEY) == 0);
+	if (!*handled) {
+		return NULL;
+	}
+	bool shown = d2s_metal_shown(who, (int)sizeof(who));
+	const char *why = shown ? "shown" : "hidden";
+	if (shown && d2s_gpu_get_info() == NULL) {
+		shown = false;
+		why = "hidden: the GPU is not up";
+	}
+	if (shown && isName && !d2s_files_wait(15000)) {
+		why = "shown, but the boot file install is still running after 15 s";
+	}
+	if (isName && d2s_metal_said < 40) {
+		d2s_metal_said++;
+		IOLog("D2S METAL: %s reads " D2S_METAL_NAME_KEY ": %s (d2smetal=%u)\n", who, why,
+		    d2s_metal_level);
+	}
+	if (!shown) {
+		return NULL;
+	}
+	return OSString::withCString(isName ? D2S_METAL_BUNDLE : D2S_METAL_CLASS);
+}
+
+OSObject *
+D2SMetalAccelerator::copyProperty(const char *aKey) const
+{
+	bool handled;
+	OSObject *obj = plugin(aKey, &handled);
+	return handled ? obj : IOAcceleratorES::copyProperty(aKey);
+}
+
+OSObject *
+D2SMetalAccelerator::copyProperty(const OSString *aKey) const
+{
+	bool handled;
+	OSObject *obj = plugin(aKey ? aKey->getCStringNoCopy() : NULL, &handled);
+	return handled ? obj : IOAcceleratorES::copyProperty(aKey);
+}
+
+OSObject *
+D2SMetalAccelerator::copyProperty(const OSSymbol *aKey) const
+{
+	bool handled;
+	OSObject *obj = plugin(aKey ? aKey->getCStringNoCopy() : NULL, &handled);
+	return handled ? obj : IOAcceleratorES::copyProperty(aKey);
+}
+
+/* IORegistryEntryCreateCFProperties and ioreg -l: the table plus the names, if shown */
+bool
+D2SMetalAccelerator::serializeProperties(OSSerialize *s) const
+{
+	bool handled, ok;
+	OSObject *name = plugin(D2S_METAL_NAME_KEY, &handled);
+	OSObject *cls = name ? plugin(D2S_METAL_CLASS_KEY, &handled) : NULL;
+	if (name == NULL || cls == NULL) {
+		OSSafeReleaseNULL(name);
+		return IOAcceleratorES::serializeProperties(s);
+	}
+	OSDictionary *d = dictionaryWithProperties();
+	ok = d != NULL && d->setObject(D2S_METAL_NAME_KEY, name) &&
+	    d->setObject(D2S_METAL_CLASS_KEY, cls) && d->serialize(s);
+	OSSafeReleaseNULL(d);
+	name->release();
+	cls->release();
+	return ok;
+}
+
+static void
+d2s_metal_publish(IOService *provider)
+{
+	uint32_t level = 0;
+	if (!PE_parse_boot_argn("d2smetal", &level, sizeof(level)) || level == 0) {
+		return;
+	}
+	d2s_metal_level = level;
+	(void)PE_parse_boot_argn("d2smtlp", d2s_metal_procs, sizeof(d2s_metal_procs));
+	D2SMetalAccelerator *acc = OSTypeAlloc(D2SMetalAccelerator);
+	if (acc == NULL || !acc->init()) {
+		OSSafeReleaseNULL(acc);
+		IOLog("D2S METAL: d2smetal=%u: no memory for the accelerator\n", level);
+		return;
+	}
+	acc->setName("D2SMetalAccelerator");
+	acc->setProperty("model", "Mali-G76 MP12");
+	acc->setProperty("D2SMetalLevel", (unsigned long long)level, 32);
+	if (!acc->attach(provider)) {
+		acc->release();
+		IOLog("D2S METAL: d2smetal=%u: attach failed\n", level);
+		return;
+	}
+	acc->registerService();
+	IOLog("D2S METAL: d2smetal=%u: IOAcceleratorES published; " D2S_METAL_BUNDLE ".bundle / "
+	    D2S_METAL_CLASS " shown to %s%s\n", level, level >= 3 ? "every process" : d2s_metal_procs,
+	    level == 2 ? " and backboardd" : "");
+	acc->release();
+}
+
