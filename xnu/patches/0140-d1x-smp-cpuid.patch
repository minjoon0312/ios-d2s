+/*
+ * Low CPU_ON trampoline, one D2S_TRAMP_SLOT slot per logical CPU in the
+ * page at 0x8f000000 (mapped uncached by startCPU; EL3 keeps the CPU_ON
+ * entry in a 32-bit register). The slot runs with the MMU off:
+ *   +0x00 adr  x25, #0x40            x25 = slot data
+ *   +0x04 mrs  x2, MPIDR_EL1
+ *   +0x08 str  x2, [x25, #0x10]      +0x50: MPIDR as this core reads it
+ *   +0x0c ldp  x26, x1, [x25]        x26 = ADT reg (cpu_phys_id), x1 = entry
+ *   +0x10 mov  x0, x26
+ *   +0x14 movz x27, #magic[15:0]
+ *   +0x18 movk x27, #magic[31:16], lsl #16
+ *   +0x1c dsb  sy
+ *   +0x20 br   x1                    sweet_secondary_entry
+ *   +0x40 ADT reg, +0x48 entry, +0x50 MPIDR (core), +0x58 cpu data PA that
+ *   reset_vector took, ~0 if it found none (core)
+ * reset_vector matches cpu_phys_id against x26 when x27 holds the magic,
+ * since the DynamIQ A55/A75 read MPIDR 0x81000n00 instead of their reg n.
+ */
+static vm_offset_t d2s_tramp;
+
+static volatile uint64_t *
+d2s_tramp_slot(unsigned int logical)
+{
+	return (volatile uint64_t *)(d2s_tramp + (vm_offset_t)logical * D2S_TRAMP_SLOT);
+}
+
+static void
+d2s_tramp_fill(unsigned int logical, uint32_t phys_id, vm_offset_t entry)
+{
+	static const uint32_t code[] = {
+		0x10000219,                                             /* adr  x25, #0x40 */
+		0xd53800a2,                                             /* mrs  x2, MPIDR_EL1 */
+		0xf9000b22,                                             /* str  x2, [x25, #0x10] */
+		0xa940073a,                                             /* ldp  x26, x1, [x25] */
+		0xaa1a03e0,                                             /* mov  x0, x26 */
+		0xd2800000U | ((D2S_TRAMP_MAGIC & 0xffffU) << 5) | 27,  /* movz x27 */
+		0xf2a00000U | ((D2S_TRAMP_MAGIC >> 16) << 5) | 27,      /* movk x27, lsl #16 */
+		0xd5033f9f,                                             /* dsb  sy */
+		0xd61f0020,                                             /* br   x1 */
+	};
+	volatile uint64_t *s = d2s_tramp_slot(logical);
+	volatile uint32_t *t = (volatile uint32_t *)s;
+
+	/* Drop any line another (cacheable) alias left for the slot, then
+	 * write it through the uncached mapping: a later write-back of a dirty
+	 * line cannot overwrite it, and the core reads it from DRAM. */
+	for (unsigned int off = 0; off < D2S_TRAMP_SLOT; off += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r"((vm_offset_t)s + off) : "memory");
+	}
+	__builtin_arm_dsb(DSB_SY);
+	for (unsigned int i = 0; i < 0x40 / 4; i++) {
+		t[i] = i < sizeof(code) / sizeof(code[0]) ? code[i] : 0xd503201f; /* nop */
+	}
+	s[8] = phys_id;                 /* +0x40 */
+	s[9] = entry;                   /* +0x48 */
+	s[10] = 0;                      /* +0x50 */
+	s[11] = 0;                      /* +0x58 */
+	__builtin_arm_dsb(DSB_SY);
+}
+#endif /* D2S */
