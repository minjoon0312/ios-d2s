+#if defined(D2S)
+/*
+ * Exynos 9825: the DynamIQ A55/A75 read MPIDR_EL1 0x81000n00 while their ADT
+ * reg (cpu phys_id) is n, so an MPIDR lookup returns -1 for A55 #2..A75 #5
+ * and M4 #0's number for A55 #1 (low bits 0x100). reset_vector picked this
+ * core's cpu data by its ADT reg (0140); once TPIDR_EL1 holds a thread (set
+ * by arm_init / arm_init_cpu before cpu_init() and PE_init_cpu(), which are
+ * the callers) use that cpu data. Before that, only the boot CPU runs, and
+ * its MPIDR low bits are 0 in either numbering.
+ */
+static cpu_data_t *
+d2s_local_cpu_data(void)
+{
+	thread_t thread = current_thread();
+	return thread != THREAD_NULL ? thread->machine.CpuDatap : NULL;
+}
+#endif /* D2S */
