+OSDefineMetaClassAndStructors(AppleARMBacklight, IOService);
+
+/* IODisplayParameters = { brightness = { min, max, value } } */
+static OSDictionary *
+d1x_bl_parameters(uint64_t value)
+{
+	OSDictionary *params = OSDictionary::withCapacity(1);
+	OSDictionary *brightness = OSDictionary::withCapacity(3);
+	OSNumber *min = OSNumber::withNumber(0ULL, 32);
+	OSNumber *max = OSNumber::withNumber((unsigned long long)D1X_BL_MAX, 32);
+	OSNumber *now = OSNumber::withNumber(value, 32);
+	if (params != NULL && brightness != NULL && min != NULL && max != NULL && now != NULL) {
+		brightness->setObject("min", min);
+		brightness->setObject("max", max);
+		brightness->setObject("value", now);
+		params->setObject("brightness", brightness);
+	}
+	OSSafeReleaseNULL(min);
+	OSSafeReleaseNULL(max);
+	OSSafeReleaseNULL(now);
+	OSSafeReleaseNULL(brightness);
+	return params;
+}
+
+/* iOS level (0 - 65536) as percent x10 (0 - 1000), for the log and d1x-bl-percent */
+static unsigned
+d1x_bl_permille(uint64_t value)
+{
+	if (value > D1X_BL_MAX) {
+		value = D1X_BL_MAX;
+	}
+	return (unsigned)((value * 1000u + D1X_BL_MAX / 2) / D1X_BL_MAX);
+}
+
+/* key names that may carry a level: logged on every change instead of only the first D1X_BL_OTHER */
+static bool
+d1x_bl_levelish(const char *key)
+{
+	static const char *const words[] = { "rightness", "nits", "Nits", "DBV", "level", "Level" };
+	for (unsigned w = 0; w < sizeof(words) / sizeof(words[0]); w++) {
+		size_t n = strlen(words[w]);
+		for (const char *p = key; *p != '\0'; p++) {
+			if (strncmp(p, words[w], n) == 0) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+bool
+AppleARMBacklight::start(IOService *provider)
+{
+	d1x_bl_mode = 0;
+	PE_parse_boot_argn("d2sbl", &d1x_bl_mode, sizeof(d1x_bl_mode));
+	if (d1x_bl_mode == 0) {
+		IOLog("D1X BL: AppleARMBacklight off (d2sbl=0)\n");
+		return false;
+	}
+	if (d1x_bl_mode >= 2) {
+		IOLog("D1X BL: d2sbl=%u: panel writes are not implemented (S6E3FA7 davinci needs MTP-based "
+		    "gamma/AOR/ELVSS, not DCS 0x51); logging only, as d2sbl=1\n", d1x_bl_mode);
+		d1x_bl_mode = 1;
+	}
+	if (d1x_bl_lock == NULL) {
+		d1x_bl_lock = IOLockAlloc();
+		if (d1x_bl_lock == NULL) {
+			return false;
+		}
+	}
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setName("backlight");
+	for (unsigned i = 0; i < sizeof(d1x_bl_adt) / sizeof(d1x_bl_adt[0]); i++) {
+		OSData *data = OSData::withBytes(d1x_bl_adt[i].bytes, d1x_bl_adt[i].length);
+		if (data != NULL) {
+			setProperty(d1x_bl_adt[i].key, data);
+			data->release();
+		}
+	}
+	setProperty("backlight-control", kOSBooleanTrue);
+	setProperty("d1x-bl-mode", (unsigned long long)d1x_bl_mode, 32);
+	publishLevel(d1x_bl_level);
+	setProperty(kIOUserClientClassKey, "AppleARMBacklightUserClient");
+	registerService();
+	IOLog("D1X BL: AppleARMBacklight registered (d2sbl=%u, iPhone X backlight properties, backlight-control, "
+	    "no panel writes)\n", d1x_bl_mode);
+	return true;
+}
+
+/* keep the level where iOS (and ioreg) can read it back */
+void
+AppleARMBacklight::publishLevel(uint64_t value)
+{
+	OSDictionary *params = d1x_bl_parameters(value);
+	if (params != NULL) {
+		setProperty("IODisplayParameters", params);
+		params->release();
+	}
+	setProperty("d1x-bl-level", (unsigned long long)value, 32);
+	setProperty("d1x-bl-percent", (unsigned long long)d1x_bl_permille(value) / 10u, 32);
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (dict == NULL) {
+		return kIOReturnBadArgument;
+	}
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+	if (it == NULL) {
+		return kIOReturnNoMemory;
+	}
+	IOLockLock(d1x_bl_lock);
+	const OSSymbol *key;
+	while ((key = OSDynamicCast(OSSymbol, it->getNextObject())) != NULL) {
+		OSObject *value = dict->getObject(key);
+		OSNumber *number = OSDynamicCast(OSNumber, value);
+		if (key->isEqualTo("IODisplayParameters")) {
+			/* { brightness = N } or { brightness = { value = N } }: the value, the range kept */
+			OSDictionary *sub = OSDynamicCast(OSDictionary, value);
+			OSObject *b = sub != NULL ? sub->getObject("brightness") : NULL;
+			OSNumber *n = OSDynamicCast(OSNumber, b);
+			if (n == NULL && OSDynamicCast(OSDictionary, b) != NULL) {
+				n = OSDynamicCast(OSNumber, OSDynamicCast(OSDictionary, b)->getObject("value"));
+			}
+			if (n == NULL) {
+				if (d1x_bl_other_said < D1X_BL_OTHER) {
+					d1x_bl_other_said++;
+					IOLog("D1X BL: %s sets IODisplayParameters without a brightness number\n", name);
+				}
+				continue;
+			}
+			uint64_t level = n->unsigned64BitValue();
+			if (level != d1x_bl_level) {
+				unsigned pm = d1x_bl_permille(level);
+				IOLog("D1X BL: %s level %llu / %u (%u.%u%%)%s\n", name, level, D1X_BL_MAX, pm / 10u, pm % 10u,
+				    level > D1X_BL_MAX ? " (above max, clamped in percent)" : "");
+				d1x_bl_level = level;
+				publishLevel(level);
+			}
+			continue;
+		}
+		const char *k = key->getCStringNoCopy();
+		bool levelish = number != NULL && d1x_bl_levelish(k);
+		bool changed = true;
+		if (levelish) {
+			OSNumber *old = OSDynamicCast(OSNumber, getProperty(key));
+			changed = old == NULL || old->unsigned64BitValue() != number->unsigned64BitValue();
+		}
+		if ((levelish && changed) || d1x_bl_other_said < D1X_BL_OTHER) {
+			if (!levelish) {
+				d1x_bl_other_said++;
+			}
+			IOLog("D1X BL: %s sets %s (%s) %llu\n", name, k,
+			    value != NULL ? value->getMetaClass()->getClassName() : "null",
+			    number != NULL ? number->unsigned64BitValue() : 0ULL);
+		}
+		if (value != NULL && !key->isEqualTo("backlight-control") && strncmp(k, "d1x-bl-", 7) != 0) {
+			setProperty(key, value);        /* kept: readable back (ioreg) */
+		}
+	}
+	IOLockUnlock(d1x_bl_lock);
+	it->release();
+	return kIOReturnSuccess;
+}
+
+class AppleARMBacklightUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleARMBacklightUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleARMBacklightUserClient, IOUserClient);
+
+IOReturn
+AppleARMBacklightUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+/*
+ * Every selector is accepted with zeroed outputs (as 0197). Which selector, if any, carries a level is not known
+ * (0197 never recorded it), so each call is logged the first time per selector and again whenever its first
+ * scalar input changes, up to D1X_BL_UC_LINES lines.
+ */
+IOReturn
+AppleARMBacklightUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutputDescriptor != NULL) {
+		IOByteCount len = args->structureOutputDescriptor->getLength();
+		for (IOByteCount off = 0; off < len; off += 8) {
+			static const uint64_t zero = 0;
+			args->structureOutputDescriptor->writeBytes(off, &zero, len - off < 8 ? len - off : 8);
+		}
+	} else if (args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	uint64_t s0 = args->scalarInputCount > 0 ? args->scalarInput[0] : 0;
+	uint64_t s1 = args->scalarInputCount > 1 ? args->scalarInput[1] : 0;
+	bool say = false;
+	IOLockLock(d1x_bl_lock);
+	if (selector >= 64) {
+		say = d1x_bl_uc_said < D1X_BL_UC_LINES;
+	} else if (!(d1x_bl_sel_seen & (1ULL << selector)) || d1x_bl_sel_last[selector] != s0) {
+		say = d1x_bl_uc_said < D1X_BL_UC_LINES;
+		d1x_bl_sel_seen |= 1ULL << selector;
+		d1x_bl_sel_last[selector] = s0;
+	}
+	if (say) {
+		d1x_bl_uc_said++;
+	}
+	IOLockUnlock(d1x_bl_lock);
+	if (say) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("D1X BL: %s sel %u in %u [%llu %llu] /%u out %u/%u -> ok\n", name, selector,
+		    args->scalarInputCount, s0, s1, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
